fi

if [[ -n "$mcp_port" ]] && { ! [[ "$mcp_port" =~ ^[0-9]+$ ]] || [[ "$mcp_port" -lt 1024 ]] || [[ "$mcp_port" -gt 65535 ]]; }; then
  echo "Invalid --port value: $mcp_port (expected integer 1024-65535)" >&2
  exit 1
fi

mcp_transport_count=$((mcp_local_selected + mcp_tunnel_selected))
[[ -z "$mcp_publish" ]] || mcp_transport_count=$((mcp_transport_count + 1))
if [[ "$mcp_transport_count" -gt 1 ]]; then
