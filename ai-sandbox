#!/usr/bin/env bash
set -euo pipefail

IMAGE="${AI_SANDBOX_IMAGE:-ai-sandbox-vscode}"
HOME_STORAGE="${AI_SANDBOX_HOME_STORAGE:-${AI_SANDBOX_HOME_VOLUME:-$HOME/.cache/ai-sandbox/home}}"
NIX_STORAGE="${AI_SANDBOX_NIX_STORAGE:-${AI_SANDBOX_NIX_VOLUME:-$HOME/.cache/ai-sandbox/nix}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_CONTEXT="${AI_SANDBOX_BUILD_CONTEXT:-$SCRIPT_DIR}"
STATE_DIR="${AI_SANDBOX_STATE_DIR:-$HOME/.local/state/ai-sandbox}"
ANDROID_STATE_DIR="${AI_SANDBOX_ANDROID_STATE_DIR:-$HOME/.cache/ai-sandbox/android}"
NETWORK_MODE="${AI_SANDBOX_NETWORK_MODE:-host}"
MCP_LIB_DIR="${AI_SANDBOX_MCP_LIB_DIR:-$SCRIPT_DIR/mcp}"

source "$MCP_LIB_DIR/host.sh"

mkdir -p "$STATE_DIR"

if [[ -z "$BUILD_CONTEXT" || ! -d "$BUILD_CONTEXT" ]]; then
  echo "AI_SANDBOX_BUILD_CONTEXT is not set or invalid." >&2
  exit 1
fi

usage() {
  cat <<'EOF'
Usage:
  ai-sandbox [start] [WORKSPACE] [--flake PATH] [--network host|bridge] [--instance NAME] [--android|--emulator|--android-emulator] [--android-gpu] [--logs] [--auto-reconnect|--no-auto-reconnect] [--auto-reconnect-interval SECONDS]
    Start (or attach to) the sandbox for a workspace and launch VS Code by default.

  ai-sandbox serve [WORKSPACE] [--flake PATH] [--instance NAME] [--port PORT] [--logs]
  ai-sandbox serve [WORKSPACE] [--instance NAME] --stop
    Start or stop browser-based code-server on a stable loopback port.

  ai-sandbox mcp [WORKSPACE] --tunnel [TUNNEL_ID] [--detach]
  ai-sandbox mcp [WORKSPACE] --status [--json]
  ai-sandbox mcp [WORKSPACE] --stop [--json]
  ai-sandbox mcp [WORKSPACE] --sessions
  ai-sandbox mcp [WORKSPACE] --attach THREAD_ID
    Start, inspect, or stop Winx MCP with sandboxed Bash access.

  ai-sandbox shell [WORKSPACE] [--flake PATH] [--network host|bridge] [--instance NAME] [--android|--emulator|--android-emulator] [--android-gpu] [-- COMMAND [ARGS...]]
    Start/attach the sandbox and open an interactive shell (or run command after --).

  ai-sandbox warm [WORKSPACE] [--flake PATH] [--network host|bridge] [--instance NAME] [--android|--emulator|--android-emulator] [--android-gpu]
    Pre-start the sandbox container and dependencies without launching VS Code.

  ai-sandbox exec [WORKSPACE] [--flake PATH] [--network host|bridge] [--instance NAME] [--android|--emulator|--android-emulator] [--android-gpu] -- COMMAND [ARGS...]
    Run a command inside the sandbox container.

  ai-sandbox install [WORKSPACE] [--force] [--only all|codex|opencode|vscode|code-server]
    Install default tools/components inside the sandbox image/runtime.

  ai-sandbox build [WORKSPACE] [--force] [--only all|codex|opencode|vscode|code-server]
    Build/update sandbox tool layers without starting an editor session.

  ai-sandbox logs [WORKSPACE] [-f|--follow]
    Show sandbox container logs (optionally follow).

  ai-sandbox doctor-net [WORKSPACE]
    Diagnose sandbox networking and connectivity assumptions.

  ai-sandbox android-doctor [WORKSPACE] [--flake PATH] [--emulator]
    Diagnose adb visibility, connected devices, and optional emulator acceleration.

  ai-sandbox reconnect-network [WORKSPACE]
    Reconnect sandbox networking using the configured network mode.

  ai-sandbox open-url URL
    Open a URL in VS Code running inside the sandbox (fallback to host editor).

  ai-sandbox open-in-editor FILE [LINE] [COLUMN]
    Open a file position in sandbox VS Code.

  ai-sandbox repair-nix
    Attempt targeted repair steps for broken Nix state in the sandbox.

  ai-sandbox prune [--force]
    Remove stopped sandbox containers, old sandbox images, and unreferenced Nix store paths.
    Running containers are kept unless --force is used; Nix/image cleanup still runs.

  ai-sandbox agents pull|push [--file PATH] [--force]
    Sync AGENTS.md between global Codex home and a project file.

  ai-sandbox agents reset|clear
    Reset or clear global Codex AGENTS state in sandbox home storage.

  ai-sandbox skills pull|push [--dir PATH] [--force]
    Sync global Codex skills directory with a project directory.

  ai-sandbox build-base
    Rebuild only the base sandbox image.

  ai-sandbox rebuild
    Rebuild sandbox image and refresh runtime state as needed.

  ai-sandbox reset-container [WORKSPACE] [--all]
    Remove sandbox container(s) for the workspace (or all known instances).

  ai-sandbox reset-storage
    Remove persisted home/nix storage for the sandbox.

  ai-sandbox reset-volumes
    Alias for reset-storage.

  ai-sandbox help
    Show this help text.
EOF
}

require_absolute_home_storage() {
  if [[ "$HOME_STORAGE" != /* ]]; then
    echo "This command requires AI_SANDBOX_HOME_STORAGE to be an absolute host path." >&2
    echo "Current HOME storage is not a host path: $HOME_STORAGE" >&2
    exit 1
  fi
}

ensure_host_codex_home() {
  local host_codex_home="$1"
  mkdir -p "$host_codex_home/skills"
}

copy_file_with_guard() {
  local src="$1"
  local dst="$2"
  local force="$3"

  if [[ -e "$dst" && "$force" -ne 1 ]]; then
    echo "Refusing to overwrite existing file without --force: $dst" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$dst")"
  cp -f "$src" "$dst"
}

copy_dir_with_guard() {
  local src="$1"
  local dst="$2"
  local force="$3"

  if [[ -e "$dst" && "$force" -ne 1 ]]; then
    echo "Refusing to overwrite existing directory without --force: $dst" >&2
    exit 1
  fi

  if [[ -e "$dst" ]]; then
    rm -rf "$dst"
  fi
  mkdir -p "$dst"
  cp -a "$src/." "$dst/"
}

run_agents_sync() {
  local sync_mode="$1"
  local path_arg="$2"
  local host_codex_home host_agents default_path disable_seed default_agents
  local opencode_config_dir opencode_agents

  require_absolute_home_storage
  host_codex_home="$HOME_STORAGE/.codex"
  host_agents="$host_codex_home/AGENTS.md"
  disable_seed="$host_codex_home/.disable_default_agents_seed"
  default_agents="$BUILD_CONTEXT/AGENTS.md"
  ensure_host_codex_home "$host_codex_home"
  default_path="$PWD/AGENTS.md"

  opencode_config_dir="$HOME_STORAGE/.config/opencode"
  opencode_agents="$opencode_config_dir/AGENTS.md"

  if [[ -n "$path_arg" ]]; then
    if [[ "$path_arg" == /* ]]; then
      default_path="$path_arg"
    else
      default_path="$(realpath -m "$path_arg")"
    fi
  fi

  case "$sync_mode" in
    pull)
      [[ -f "$host_agents" ]] || { echo "No global AGENTS file found at: $host_agents" >&2; exit 1; }
      copy_file_with_guard "$host_agents" "$default_path" "$install_force"
      echo "Pulled global AGENTS from $host_agents to $default_path"
      ;;
    push)
      [[ -f "$default_path" ]] || { echo "Source AGENTS file not found: $default_path" >&2; exit 1; }
      copy_file_with_guard "$default_path" "$host_agents" "$install_force"
      echo "Pushed AGENTS from $default_path to global path $host_agents"
      ;;
    reset)
      [[ -f "$default_agents" ]] || { echo "Default AGENTS template not found: $default_agents" >&2; exit 1; }
      copy_file_with_guard "$default_agents" "$host_agents" 1
      rm -f "$disable_seed"
      echo "Reset global AGENTS to default template at $host_agents"
      ;;
    clear)
      rm -f "$host_agents" "$host_codex_home/AGENTS.override.md" "$disable_seed"
      echo "Cleared global AGENTS overrides from $host_codex_home"
      echo "Default AGENTS will be seeded again on next container startup."
      ;;
    *)
      echo "Invalid agents mode: $sync_mode (expected pull|push|reset|clear)" >&2
      exit 1
      ;;
  esac

  mkdir -p "$opencode_config_dir"
  if [[ -f "$host_agents" ]]; then
    if [[ -L "$opencode_agents" ]]; then
      :
    elif [[ -e "$opencode_agents" && ! -L "$opencode_agents" ]]; then
      rm -f "$opencode_agents"
      ln -sf "$host_agents" "$opencode_agents"
    else
      ln -sf "$host_agents" "$opencode_agents"
    fi
    echo "Linked opencode global AGENTS to $host_agents"
  else
    rm -f "$opencode_agents"
    echo "Removed opencode global AGENTS symlink (no source file)"
  fi
}

run_skills_sync() {
  local sync_mode="$1"
  local path_arg="$2"
  local host_codex_home host_skills default_dir

  require_absolute_home_storage
  host_codex_home="$HOME_STORAGE/.codex"
  host_skills="$host_codex_home/skills"
  ensure_host_codex_home "$host_codex_home"
  default_dir="$PWD/skills"

  if [[ -n "$path_arg" ]]; then
    if [[ "$path_arg" == /* ]]; then
      default_dir="$path_arg"
    else
      default_dir="$(realpath -m "$path_arg")"
    fi
  fi

  case "$sync_mode" in
    pull)
      [[ -d "$host_skills" ]] || { echo "No global skills directory found at: $host_skills" >&2; exit 1; }
      copy_dir_with_guard "$host_skills" "$default_dir" "$install_force"
      echo "Pulled global skills from $host_skills to $default_dir"
      ;;
    push)
      [[ -d "$default_dir" ]] || { echo "Source skills directory not found: $default_dir" >&2; exit 1; }
      copy_dir_with_guard "$default_dir" "$host_skills" "$install_force"
      echo "Pushed skills from $default_dir to global path $host_skills"
      ;;
    *)
      echo "Invalid skills mode: $sync_mode (expected pull|push)" >&2
      exit 1
      ;;
  esac
}

ensure_image_exists() {
  if podman image exists "$IMAGE"; then
    return 0
  fi
  echo "Image '$IMAGE' not found locally. Building from $BUILD_CONTEXT..." >&2
  podman build -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
}

storage_mount_spec() {
  local storage="$1"
  local target="$2"
  local selinux_label_opt="$3"

  if [[ "$storage" == /* ]]; then
    mkdir -p "$storage"
    printf '%s:%s%s\n' "$storage" "$target" "$selinux_label_opt"
  else
    printf '%s:%s%s,U\n' "$storage" "$target" "$selinux_label_opt"
  fi
}

require_safe_storage_path() {
  local storage_name="$1"
  local storage_path="$2"

  case "$storage_path" in
    ""|"/")
      echo "Refusing to prune unsafe $storage_name path: $storage_path" >&2
      return 1
      ;;
  esac
}

run_nix_gc() {
  local home_mount_spec nix_mount_spec selinux_label_opt
  selinux_label_opt="$(selinux_mount_label_opt)"
  home_mount_spec="$(storage_mount_spec "$HOME_STORAGE" /sandbox-home "$selinux_label_opt")"
  nix_mount_spec="$(storage_mount_spec "$NIX_STORAGE" /nix "$selinux_label_opt")"

  echo "Collecting unreferenced paths from the shared ai-sandbox Nix store..."
  podman run --rm \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --group-add keep-groups \
    -e HOME=/sandbox-home \
    -e XDG_RUNTIME_DIR=/tmp/xdg-runtime \
    -e AI_SANDBOX_MODE=gc \
    -v "$home_mount_spec" \
    -v "$nix_mount_spec" \
    "$IMAGE"
}

prune_legacy_images() {
  local image_id image_name image_names
  local -a legacy_image_ids=()

  while IFS= read -r image_id; do
    [[ -n "$image_id" ]] || continue
    image_names="$(podman image inspect \
      --format '{{range .NamesHistory}}{{println .}}{{end}}' \
      "$image_id" 2>/dev/null || true)"
    while IFS= read -r image_name; do
      case "$image_name" in
        "$IMAGE"|"$IMAGE":*)
          legacy_image_ids+=("$image_id")
          break
          ;;
      esac
    done <<< "$image_names"
  done < <(
    podman images --all \
      --filter dangling=true \
      --no-trunc \
      --format '{{.ID}}'
  )

  for image_id in "${legacy_image_ids[@]}"; do
    echo "Removing legacy ai-sandbox image: $image_id"
    podman image rm "$image_id" >/dev/null 2>&1 || true
  done
}

run_prune() {
  local containers_skipped=0
  local -a running_containers sandbox_containers

  require_safe_storage_path "HOME" "$HOME_STORAGE"
  require_safe_storage_path "Nix" "$NIX_STORAGE"

  mapfile -t running_containers < <(
    podman ps --filter label=ai-sandbox=true --format '{{.Names}}'
  )
  if [[ ${#running_containers[@]} -gt 0 && "$prune_force" -ne 1 ]]; then
    echo "Running ai-sandbox containers found: ${running_containers[*]}" >&2
    echo "Leaving them running; continuing with Nix GC and image cleanup." >&2
    containers_skipped=1
  else
    mapfile -t sandbox_containers < <(
      podman ps -aq --filter label=ai-sandbox=true --format '{{.Names}}'
    )
    if [[ ${#sandbox_containers[@]} -gt 0 ]]; then
      if [[ "$prune_force" -eq 1 ]]; then
        podman rm -f "${sandbox_containers[@]}" >/dev/null
      else
        podman rm "${sandbox_containers[@]}" >/dev/null
      fi
      echo "Removed sandbox containers: ${sandbox_containers[*]}"
    else
      echo "No sandbox containers to remove."
    fi
  fi

  ensure_image_exists
  run_nix_gc

  prune_legacy_images
  echo "Removing unused images labeled ai-sandbox=true..."
  podman image prune --force --filter label=ai-sandbox=true
  if [[ "$containers_skipped" -eq 1 ]]; then
    echo "AI sandbox prune complete; running containers were kept."
  else
    echo "AI sandbox prune complete."
  fi
}

follow_startup_logs_until_vscode() {
  local container="$1"
  local marker="AI_SANDBOX_READY_VSCODE:"
  echo "Streaming startup logs until VS Code launches..."
  (
    set +e
    set +o pipefail
    podman logs -f "$container" 2>&1 | awk -v marker="$marker" '
      { print; fflush(); if (index($0, marker)) exit 0 }
    '
  ) || true
}

wait_for_code_server() {
  local container="$1"
  local port="$2"
  local attempt
  echo "Waiting for code-server on 127.0.0.1:$port..."
  for ((attempt = 1; attempt <= 90; attempt++)); do
    if curl -fsS --max-time 1 "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; then
      echo "AI_SANDBOX_READY_CODE_SERVER: http://127.0.0.1:$port"
      echo "SSH tunnel: ssh -N -L $port:127.0.0.1:$port <remote-host>"
      return 0
    fi
    if [[ "$(podman inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true)" != "true" ]]; then
      echo "Code-server container stopped before becoming ready." >&2
      podman logs "$container" >&2 || true
      return 1
    fi
    sleep 1
  done
  echo "Timed out waiting for code-server." >&2
  podman logs "$container" >&2 || true
  return 1
}

ensure_vscode_url_handler() {
  local desktop_dir desktop_file ai_sandbox_cmd
  desktop_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  desktop_file="$desktop_dir/ai-sandbox-vscode-url-handler.desktop"

  ai_sandbox_cmd="$(command -v ai-sandbox || true)"
  if [[ -z "$ai_sandbox_cmd" ]]; then
    ai_sandbox_cmd="$(realpath "$0")"
  fi

  mkdir -p "$desktop_dir"
  cat > "$desktop_file" <<EOF
[Desktop Entry]
Name=AI Sandbox VS Code URL Handler
Exec=$ai_sandbox_cmd open-url %u
Terminal=false
Type=Application
MimeType=x-scheme-handler/vscode;x-scheme-handler/vscode-insiders;
Categories=Development;
NoDisplay=true
EOF

  if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default ai-sandbox-vscode-url-handler.desktop x-scheme-handler/vscode >/dev/null 2>&1 || true
    xdg-mime default ai-sandbox-vscode-url-handler.desktop x-scheme-handler/vscode-insiders >/dev/null 2>&1 || true
  fi

  if command -v xdg-settings >/dev/null 2>&1; then
    xdg-settings set default-url-scheme-handler vscode ai-sandbox-vscode-url-handler.desktop >/dev/null 2>&1 || true
    xdg-settings set default-url-scheme-handler vscode-insiders ai-sandbox-vscode-url-handler.desktop >/dev/null 2>&1 || true
  fi

  if command -v gio >/dev/null 2>&1; then
    gio mime x-scheme-handler/vscode ai-sandbox-vscode-url-handler.desktop >/dev/null 2>&1 || true
    gio mime x-scheme-handler/vscode-insiders ai-sandbox-vscode-url-handler.desktop >/dev/null 2>&1 || true
  fi
}

detect_theme() {
  local scheme=""
  if command -v kreadconfig5 >/dev/null 2>&1; then
    scheme="$(kreadconfig5 --file "$HOME/.config/kdeglobals" --group General --key ColorScheme 2>/dev/null || true)"
  fi
  if [[ -z "$scheme" && -f "$HOME/.config/kdeglobals" ]]; then
    scheme="$(grep -E '^ColorScheme=' "$HOME/.config/kdeglobals" | head -n1 | cut -d= -f2- || true)"
  fi

  case "${scheme,,}" in
    *dark*|*black*|*night*) echo "dark" ;;
    *) echo "light" ;;
  esac
}

selinux_mount_label_opt() {
  if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
    printf ':Z'
    return 0
  fi
  printf ''
}

ensure_android_state_dir() {
  if [[ "$ANDROID_STATE_DIR" != /* ]]; then
    echo "AI_SANDBOX_ANDROID_STATE_DIR must be an absolute host path." >&2
    echo "Current Android state path is not a host path: $ANDROID_STATE_DIR" >&2
    exit 1
  fi

  mkdir -p \
    "$ANDROID_STATE_DIR/avd" \
    "$ANDROID_STATE_DIR/user" \
    "$ANDROID_STATE_DIR/emulator"
}

require_emulator_access() {
  if [[ ! -e /dev/kvm ]]; then
    echo "In-container emulator mode requires /dev/kvm, but it is unavailable." >&2
    echo "Use 'ai-sandbox start --android' with an emulator running on the host." >&2
    echo "Do not fall back to software emulation; it is intentionally not enabled." >&2
    exit 1
  fi

  if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    echo "In-container emulator mode can see /dev/kvm but cannot access it." >&2
    echo "Add the launching user to the host kvm group, then start again." >&2
    exit 1
  fi

  if [[ "$android_gpu" -eq 1 && ! -e /dev/dri ]]; then
    echo "--android-gpu requested /dev/dri, but /dev/dri is unavailable." >&2
    echo "Omit --android-gpu for headless emulator operation." >&2
    exit 1
  fi
}

pick_running_container() {
  if [[ -f "$STATE_DIR/last-container" ]]; then
    local c
    c="$(cat "$STATE_DIR/last-container" 2>/dev/null || true)"
    if [[ -n "$c" ]] && podman inspect "$c" >/dev/null 2>&1; then
      if [[ "$(podman inspect -f '{{.State.Running}}' "$c" 2>/dev/null || true)" == "true" ]]; then
        echo "$c"
        return 0
      fi
    fi
  fi

  podman ps --filter label=ai-sandbox=true --format '{{.Names}}' | head -n1
}

pick_running_container_for_workspace() {
  local workspace_path="$1"
  local profile="${2:-}"
  local -a filters

  filters=(
    --filter label=ai-sandbox=true
    --filter "label=ai-sandbox.workspace=$workspace_path"
  )
  if [[ -n "$profile" ]]; then
    filters+=(--filter "label=ai-sandbox.profile=$profile")
  fi

  podman ps \
    "${filters[@]}" \
    --format '{{.Names}}' | head -n1
}

container_workspace_from_env() {
  local container="$1"
  local env_dump existing_workspace

  env_dump="$(podman inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null || true)"
  existing_workspace="$(printf '%s\n' "$env_dump" | sed -n 's/^AI_SANDBOX_WORKSPACE=//p' | head -n1)"
  [[ -n "$existing_workspace" ]] || existing_workspace="/workspace"
  printf '%s\n' "$existing_workspace"
}

pick_running_container_for_file() {
  local file_path="$1"
  local best_name=""
  local best_len=0
  local name ws ws_len

  while IFS=$'\t' read -r name ws; do
    [[ -n "$name" && -n "$ws" ]] || continue

    if [[ "$file_path" == "$ws" || "$file_path" == "$ws/"* ]]; then
      ws_len="${#ws}"
      if (( ws_len > best_len )); then
        best_len="$ws_len"
        best_name="$name"
      fi
    fi
  done < <(
    podman ps \
      --filter label=ai-sandbox=true \
      --format '{{.Names}}	{{.Label "ai-sandbox.workspace"}}'
  )

  if [[ -n "$best_name" ]]; then
    echo "$best_name"
    return 0
  fi

  return 1
}

map_host_target_for_container() {
  local container="$1"
  local target="$2"
  local path_part="$target"
  local line_part=""
  local col_part=""
  local host_root=""
  local container_root=""
  local mapped_path=""
  local env_dump

  if [[ "$target" =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
    path_part="${BASH_REMATCH[1]}"
    line_part="${BASH_REMATCH[2]}"
    col_part="${BASH_REMATCH[3]}"
  elif [[ "$target" =~ ^(.+):([0-9]+)$ ]]; then
    path_part="${BASH_REMATCH[1]}"
    line_part="${BASH_REMATCH[2]}"
  fi

  env_dump="$(podman inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null || true)"
  host_root="$(printf '%s\n' "$env_dump" | sed -n 's/^AI_SANDBOX_HOST_MOUNT_ROOT=//p' | head -n1)"
  container_root="$(printf '%s\n' "$env_dump" | sed -n 's/^AI_SANDBOX_CONTAINER_MOUNT_ROOT=//p' | head -n1)"
  [[ -n "$container_root" ]] || container_root="/workspace"

  mapped_path="$path_part"
  if [[ -n "$host_root" ]]; then
    if [[ "$path_part" == "$host_root" ]]; then
      mapped_path="$container_root"
    elif [[ "$path_part" == "$host_root/"* ]]; then
      mapped_path="$container_root/${path_part#"$host_root"/}"
    fi
  fi

  if [[ -n "$line_part" && -n "$col_part" ]]; then
    printf '%s:%s:%s\n' "$mapped_path" "$line_part" "$col_part"
    return 0
  fi
  if [[ -n "$line_part" ]]; then
    printf '%s:%s\n' "$mapped_path" "$line_part"
    return 0
  fi
  printf '%s\n' "$mapped_path"
}

sanitize_instance_name() {
  local raw="$1"
  local cleaned
  cleaned="$(echo -n "$raw" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_.-' '-')"
  cleaned="${cleaned#-}"
  cleaned="${cleaned%-}"

  if [[ -z "$cleaned" ]]; then
    echo "Invalid --instance value: '$raw' (expected letters, numbers, ., _, -)" >&2
    exit 1
  fi

  echo "$cleaned"
}

sanitize_container_name_part() {
  local raw="$1"
  local fallback="$2"
  local cleaned
  cleaned="$(echo -n "$raw" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_.-' '-')"
  cleaned="${cleaned#-}"
  cleaned="${cleaned%-}"
  cleaned="${cleaned:0:32}"

  if [[ -z "$cleaned" ]]; then
    echo "$fallback"
    return
  fi

  echo "$cleaned"
}

port_is_listening() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
}

port_is_assigned_elsewhere() {
  local port="$1"
  local own_file="$2"
  local file
  [[ -d "$STATE_DIR/code-server-ports" ]] || return 1
  for file in "$STATE_DIR"/code-server-ports/*; do
    [[ -f "$file" && "$file" != "$own_file" ]] || continue
    [[ "$(<"$file")" == "$port" ]] && return 0
  done
  return 1
}

resolve_code_server_port() {
  local hash="$1"
  local instance="$2"
  local container="$3"
  local requested="$4"
  local port_dir="$STATE_DIR/code-server-ports"
  local assignment="$port_dir/${hash}-${instance}"
  local existing_state stored candidate start offset
  mkdir -p "$port_dir"
  stored=""
  [[ -f "$assignment" ]] && stored="$(<"$assignment")"
  existing_state="$(podman inspect -f '{{.State.Status}}' "$container" 2>/dev/null || true)"

  if [[ -n "$requested" ]]; then
    if [[ -n "$stored" && "$stored" != "$requested" ]]; then
      [[ "$existing_state" != "running" ]] ||
        { echo "Stop the code-server before changing its port." >&2; return 1; }
      if [[ -n "$existing_state" ]]; then
        podman rm "$container" >/dev/null
        existing_state=""
      fi
    fi
    candidate="$requested"
  elif [[ -n "$stored" ]]; then
    candidate="$stored"
  else
    start=$((18080 + 16#${hash:0:6} % 920))
    candidate=""
    for ((offset = 0; offset < 920; offset++)); do
      local probe=$((18080 + (start - 18080 + offset) % 920))
      if ! port_is_assigned_elsewhere "$probe" "$assignment" && ! port_is_listening "$probe"; then
        candidate="$probe"
        break
      fi
    done
    [[ -n "$candidate" ]] ||
      { echo "No free code-server port found in 18080-18999." >&2; return 1; }
  fi

  if port_is_assigned_elsewhere "$candidate" "$assignment"; then
    echo "Code-server port $candidate is assigned to another workspace." >&2
    return 1
  fi
  if [[ "$existing_state" != "running" ]] && port_is_listening "$candidate"; then
    echo "Code-server port $candidate is already in use." >&2
    return 1
  fi

  printf '%s\n' "$candidate" >"$assignment"
  printf '%s\n' "$candidate"
}

pick_auto_instance_name() {
  local base_name="$1"
  local preferred="default"
  local preferred_container="${base_name}-${preferred}"

  # Reuse a stable default instance name for persistent VS Code profile state.
  # If that container name is already in use (e.g. another live session), fall
  # back to a unique instance suffix.
  if podman inspect "$preferred_container" >/dev/null 2>&1; then
    local rand_suffix
    rand_suffix="$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
    echo "${preferred}-$(date +%Y%m%d-%H%M%S)-${rand_suffix}"
    return
  fi

  echo "$preferred"
}

container_is_running() {
  local container="$1"
  [[ "$(podman inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true)" == "true" ]]
}

container_network_mode() {
  local container="$1"
  local env_dump mode
  env_dump="$(podman inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null || true)"
  mode="$(printf '%s\n' "$env_dump" | sed -n 's/^AI_SANDBOX_NETWORK_MODE=//p' | head -n1)"
  if [[ -z "$mode" ]]; then
    mode="$(podman inspect -f '{{.HostConfig.NetworkMode}}' "$container" 2>/dev/null || true)"
  fi

  if [[ "$mode" == "host" ]]; then
    echo "host"
    return
  fi
  echo "bridge"
}

probe_container_dns() {
  local container="$1"
  podman exec "$container" /bin/bash -lc \
    'timeout 3s getent hosts api.openai.com >/dev/null 2>&1'
}

probe_container_https_ip() {
  local container="$1"
  podman exec "$container" /bin/bash -lc \
    'curl -fsS --connect-timeout 3 --max-time 6 https://1.1.1.1 >/dev/null 2>&1'
}

container_connectivity_healthy() {
  local container="$1"
  probe_container_dns "$container" && probe_container_https_ip "$container"
}

sync_container_resolver_from_host() {
  local container="$1"
  local host_resolv
  host_resolv="$(cat /etc/resolv.conf 2>/dev/null || true)"
  [[ -n "$host_resolv" ]] || return 1
  printf '%s\n' "$host_resolv" | podman exec -i --user 0 "$container" /bin/sh -lc 'cat >/etc/resolv.conf'
}

network_fingerprint() {
  {
    ip route show default 2>/dev/null || true
    cat /etc/resolv.conf 2>/dev/null || true
  } | sha256sum | awk '{print $1}'
}

reconnect_container_network() {
  local container="$1"
  local source="${2:-manual}"
  local mode dns_before ip_before dns_after ip_after

  if ! container_is_running "$container"; then
    echo "AI_SANDBOX_NET[$source]: container is not running: $container" >&2
    return 1
  fi

  mode="$(container_network_mode "$container")"
  dns_after="fail"
  ip_after="fail"

  if [[ "$mode" == "host" ]]; then
    if sync_container_resolver_from_host "$container"; then
      echo "AI_SANDBOX_NET[$source]: synced /etc/resolv.conf from host"
    else
      echo "AI_SANDBOX_NET[$source]: resolver sync failed (continuing with probes)" >&2
    fi
  else
    dns_before="fail"
    ip_before="fail"
    if probe_container_dns "$container"; then
      dns_before="ok"
    fi
    if probe_container_https_ip "$container"; then
      ip_before="ok"
    fi
    echo "AI_SANDBOX_NET[$source]: precheck container=$container mode=$mode dns=$dns_before ip=$ip_before"
    echo "AI_SANDBOX_NET[$source]: skipping resolver sync in bridge mode"
  fi

  if probe_container_dns "$container"; then
    dns_after="ok"
  fi
  if probe_container_https_ip "$container"; then
    ip_after="ok"
  fi

  echo "AI_SANDBOX_NET[$source]: postcheck container=$container dns=$dns_after ip=$ip_after"

  if [[ "$dns_after" == "ok" ]]; then
    return 0
  fi
  if [[ "$ip_after" == "ok" ]]; then
    return 2
  fi
  return 1
}

maybe_start_auto_reconnect_watcher() {
  local container="$1"
  local mode="$2"
  local interval="$3"
  local pid_file watcher_log watcher_pid

  if [[ "$mode" != "host" ]]; then
    echo "Auto-reconnect watcher skipped for non-host network mode."
    return 0
  fi

  pid_file="$STATE_DIR/network-watcher-${container}.pid"
  watcher_log="$STATE_DIR/network-watcher-${container}.log"

  if [[ -f "$pid_file" ]]; then
    watcher_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$watcher_pid" ]] && kill -0 "$watcher_pid" 2>/dev/null; then
      echo "Auto-reconnect watcher already running (pid=$watcher_pid)."
      return 0
    fi
  fi

  (
    prev_fp="$(network_fingerprint)"
    echo "AI_SANDBOX_NET[watcher]: started for $container interval=${interval}s"

    while container_is_running "$container"; do
      sleep "$interval"
      current_fp="$(network_fingerprint)"
      if [[ "$current_fp" != "$prev_fp" ]]; then
        echo "AI_SANDBOX_NET[watcher]: host network fingerprint changed; reconnecting..."
        reconnect_container_network "$container" "auto" || true
      elif ! container_connectivity_healthy "$container"; then
        echo "AI_SANDBOX_NET[watcher]: container connectivity probe failed; reconnecting..."
        reconnect_container_network "$container" "auto" || true
      fi
      prev_fp="$current_fp"
    done

    echo "AI_SANDBOX_NET[watcher]: stopping for $container"
    rm -f "$pid_file"
  ) >>"$watcher_log" 2>&1 &

  echo "$!" > "$pid_file"
  echo "Started auto-reconnect watcher (pid=$!, log=$watcher_log)."
}

cmd="start"
workspace="$PWD"
flake_arg=""
open_url_arg=""
open_editor_file=""
open_editor_line=""
open_editor_col=""
instance_arg=""
follow_logs_on_start=0
logs_follow=0
exec_command=()
shell_command=()
workspace_explicit=0
install_force=0
install_only="all"
auto_reconnect="${AI_SANDBOX_AUTO_RECONNECT:-1}"
auto_reconnect_interval="${AI_SANDBOX_AUTO_RECONNECT_INTERVAL:-8}"
sync_mode=""
sync_path_arg=""
reset_all_containers=0
prune_force=0
server_port=""
server_stop=0
mcp_mode="write"
mcp_mode_selected=0
mcp_status=0
mcp_stop=0
mcp_json=0
mcp_port=""
mcp_local_selected=0
mcp_tunnel_selected=0
mcp_tunnel_id=""
mcp_runtime_api_key=""
mcp_detach=0
mcp_sessions=0
mcp_attach_id=""
network_selected=0
android_mode=0
emulator_mode=0
android_gpu=0

if [[ $# -gt 0 ]]; then
  case "$1" in
    start|serve|mcp|shell|warm|exec|install|build|logs|doctor-net|android-doctor|reconnect-network|build-base|rebuild|reset-container|reset-storage|reset-volumes|repair-nix|prune|agents|skills|open-url|open-in-editor|help|-h|--help)
      cmd="$1"
      shift
      ;;
    *)
      cmd="start"
      ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    pull|push|reset|clear)
      if [[ "$cmd" == "agents" || "$cmd" == "skills" ]]; then
        [[ -z "$sync_mode" ]] || { echo "$cmd accepts exactly one mode" >&2; exit 1; }
        if [[ "$cmd" == "skills" && ( "$1" == "reset" || "$1" == "clear" ) ]]; then
          echo "skills accepts pull|push only" >&2
          exit 1
        fi
        sync_mode="$1"
        shift
        continue
      fi
      ;;
    --)
      shift
      if [[ "$cmd" == "exec" ]]; then
        exec_command=("$@")
        break
      elif [[ "$cmd" == "shell" ]]; then
        shell_command=("$@")
        break
      fi
      ;;
    --force)
      if [[ "$cmd" == "install" || "$cmd" == "build" || "$cmd" == "agents" || "$cmd" == "skills" ]]; then
        install_force=1
        shift
        continue
      elif [[ "$cmd" == "prune" ]]; then
        prune_force=1
        shift
        continue
      fi
      echo "--force is only valid with install/build/agents/skills/prune" >&2
      exit 1
      ;;
    --file)
      if [[ "$cmd" == "agents" ]]; then
        shift
        [[ $# -gt 0 ]] || { echo "--file requires a path" >&2; exit 1; }
        sync_path_arg="$1"
        shift
        continue
      fi
      echo "--file is only valid with agents" >&2
      exit 1
      ;;
    --dir)
      if [[ "$cmd" == "skills" ]]; then
        shift
        [[ $# -gt 0 ]] || { echo "--dir requires a path" >&2; exit 1; }
        sync_path_arg="$1"
        shift
        continue
      fi
      echo "--dir is only valid with skills" >&2
      exit 1
      ;;
    --only)
      if [[ "$cmd" == "install" || "$cmd" == "build" ]]; then
        shift
        [[ $# -gt 0 ]] || { echo "--only requires all|codex|opencode|vscode|code-server" >&2; exit 1; }
        install_only="$1"
        shift
        continue
      fi
      echo "--only is only valid with install/build" >&2
      exit 1
      ;;
    --flake)
      shift
      [[ $# -gt 0 ]] || { echo "--flake requires a path" >&2; exit 1; }
      flake_arg="$(realpath "$1")"
      shift
      ;;
    --network)
      shift
      [[ $# -gt 0 ]] || { echo "--network requires host or bridge" >&2; exit 1; }
      NETWORK_MODE="$1"
      network_selected=1
      shift
      ;;
    --android)
      case "$cmd" in
        start|shell|warm|exec|android-doctor)
          android_mode=1
          shift
          continue
          ;;
        *)
          echo "--android is only valid with start/shell/warm/exec/android-doctor" >&2
          exit 1
          ;;
      esac
      ;;
    --emulator|--android-emulator)
      case "$cmd" in
        start|shell|warm|exec|android-doctor)
          android_mode=1
          emulator_mode=1
          shift
          continue
          ;;
        *)
          echo "--emulator/--android-emulator is only valid with start/shell/warm/exec/android-doctor" >&2
          exit 1
          ;;
      esac
      ;;
    --android-gpu)
      case "$cmd" in
        start|shell|warm|exec|android-doctor)
          android_gpu=1
          shift
          continue
          ;;
        *)
          echo "--android-gpu is only valid with start/shell/warm/exec/android-doctor" >&2
          exit 1
          ;;
      esac
      ;;
    --instance)
      shift
      [[ $# -gt 0 ]] || { echo "--instance requires a name" >&2; exit 1; }
      instance_arg="$(sanitize_instance_name "$1")"
      shift
      ;;
    --port)
      if [[ "$cmd" == "serve" || "$cmd" == "mcp" ]]; then
        shift
        [[ $# -gt 0 ]] || { echo "--port requires a value" >&2; exit 1; }
        if [[ "$cmd" == "serve" ]]; then
          server_port="$1"
        else
          mcp_port="$1"
        fi
        shift
        continue
      fi
      echo "--port is only valid with serve or mcp" >&2
      exit 1
      ;;
    --stop)
      if [[ "$cmd" == "serve" || "$cmd" == "mcp" ]]; then
        if [[ "$cmd" == "serve" ]]; then
          server_stop=1
        else
          mcp_stop=1
        fi
        shift
        continue
      fi
      echo "--stop is only valid with serve or mcp" >&2
      exit 1
      ;;
    --status)
      [[ "$cmd" == "mcp" ]] || { echo "--status is only valid with mcp" >&2; exit 1; }
      mcp_status=1
      shift
      ;;
    --json)
      [[ "$cmd" == "mcp" ]] || { echo "--json is only valid with mcp" >&2; exit 1; }
      mcp_json=1
      shift
      ;;
    --local)
      [[ "$cmd" == "mcp" ]] || { echo "--local is only valid with mcp" >&2; exit 1; }
      mcp_local_selected=1
      shift
      ;;
    --tunnel)
      [[ "$cmd" == "mcp" ]] || { echo "--tunnel is only valid with mcp" >&2; exit 1; }
      mcp_tunnel_selected=1
      shift
      if [[ $# -gt 0 && "$1" != -* ]]; then
        mcp_tunnel_id="$1"
        shift
      fi
      ;;
    --detach)
      [[ "$cmd" == "mcp" ]] || { echo "--detach is only valid with mcp" >&2; exit 1; }
      mcp_detach=1
      shift
      ;;
    --sessions)
      [[ "$cmd" == "mcp" ]] || { echo "--sessions is only valid with mcp" >&2; exit 1; }
      mcp_sessions=1
      shift
      ;;
    --attach)
      [[ "$cmd" == "mcp" ]] || { echo "--attach is only valid with mcp" >&2; exit 1; }
      shift
      [[ $# -gt 0 ]] || { echo "--attach requires a thread ID" >&2; exit 1; }
      mcp_attach_id="$1"
      shift
      ;;
    --read-only|--ship)
      [[ "$cmd" == "mcp" ]] || { echo "$1 is only valid with mcp" >&2; exit 1; }
      [[ "$mcp_mode_selected" -eq 0 ]] || {
        echo "--read-only and --ship are mutually exclusive." >&2
        exit 1
      }
      mcp_mode_selected=1
      if [[ "$1" == "--read-only" ]]; then
        mcp_mode="read"
      else
        mcp_mode="ship"
      fi
      shift
      ;;
    --logs)
      follow_logs_on_start=1
      shift
      ;;
    --all)
      if [[ "$cmd" == "reset-container" ]]; then
        reset_all_containers=1
        shift
        continue
      fi
      echo "--all is only valid with reset-container" >&2
      exit 1
      ;;
    --auto-reconnect)
      auto_reconnect=1
      shift
      ;;
    --no-auto-reconnect)
      auto_reconnect=0
      shift
      ;;
    --auto-reconnect-interval)
      shift
      [[ $# -gt 0 ]] || { echo "--auto-reconnect-interval requires seconds" >&2; exit 1; }
      auto_reconnect_interval="$1"
      shift
      ;;
    -f|--follow)
      logs_follow=1
      shift
      ;;
    *)
      if [[ "$cmd" == "exec" ]]; then
        if [[ "$workspace_explicit" -eq 0 && -d "$1" ]]; then
          workspace="$(realpath "$1")"
          workspace_explicit=1
          shift
          continue
        fi
        exec_command=("$@")
        break
      elif [[ "$cmd" == "shell" ]]; then
        if [[ "$workspace_explicit" -eq 0 && -d "$1" ]]; then
          workspace="$(realpath "$1")"
          workspace_explicit=1
          shift
          continue
        fi
        shell_command=("$@")
        break
      elif [[ "$cmd" == "open-url" && -z "$open_url_arg" ]]; then
        open_url_arg="$1"
      elif [[ "$cmd" == "open-in-editor" ]]; then
        if [[ -z "$open_editor_file" ]]; then
          if [[ "$1" == /* ]]; then
            open_editor_file="$1"
          else
            open_editor_file="$(realpath -m "$1")"
          fi
        elif [[ -z "$open_editor_line" ]]; then
          open_editor_line="$1"
        elif [[ -z "$open_editor_col" ]]; then
          open_editor_col="$1"
        else
          echo "open-in-editor accepts at most FILE [LINE] [COLUMN]" >&2
          exit 1
        fi
      elif [[ "$cmd" == "mcp" ]]; then
        [[ "$workspace_explicit" -eq 0 ]] || {
          echo "mcp accepts at most one WORKSPACE argument." >&2
          exit 1
        }
        workspace="$(realpath "$1")"
        workspace_explicit=1
      else
        workspace="$(realpath "$1")"
      fi
      shift
      ;;
  esac
done

if [[ "$cmd" == "exec" && ${#exec_command[@]} -eq 0 ]]; then
  echo "exec requires a command. Example: ai-sandbox exec -- codex --version" >&2
  exit 2
fi

if [[ "$cmd" == "android-doctor" ]]; then
  android_mode=1
fi

case "$install_only" in
  all|codex|opencode|vscode|code-server) ;;
  *)
    echo "Invalid --only value: $install_only (expected all|codex|opencode|vscode|code-server)" >&2
    exit 1
    ;;
esac

if [[ -n "$server_port" ]] && { ! [[ "$server_port" =~ ^[0-9]+$ ]] || [[ "$server_port" -lt 1024 ]] || [[ "$server_port" -gt 65535 ]]; }; then
  echo "Invalid --port value: $server_port (expected integer 1024-65535)" >&2
  exit 1
fi

if [[ -n "$mcp_port" ]] && { ! [[ "$mcp_port" =~ ^[0-9]+$ ]] || [[ "$mcp_port" -lt 1024 ]] || [[ "$mcp_port" -gt 65535 ]]; }; then
  echo "Invalid --port value: $mcp_port (expected integer 1024-65535)" >&2
  exit 1
fi

if [[ "$mcp_local_selected" -eq 1 && "$mcp_tunnel_selected" -eq 1 ]]; then
  echo "mcp --local and --tunnel are mutually exclusive." >&2
  exit 1
fi

if [[ -n "$mcp_tunnel_id" && ! "$mcp_tunnel_id" =~ ^tunnel_[a-z0-9]{32}$ ]]; then
  echo "Invalid --tunnel value: expected tunnel_<32 lowercase letters or digits>." >&2
  exit 1
fi

if [[ "$mcp_status" -eq 1 && "$mcp_stop" -eq 1 ]]; then
  echo "mcp --status and --stop are mutually exclusive." >&2
  exit 1
fi

if [[ "$mcp_detach" -eq 1 && "$mcp_tunnel_selected" -ne 1 ]]; then
  echo "mcp --detach requires --tunnel." >&2
  exit 1
fi

if [[ "$cmd" == mcp && ( "$mcp_sessions" -eq 1 || -n "$mcp_attach_id" ) ]] &&
  { [[ "$mcp_sessions" -eq 1 && -n "$mcp_attach_id" ]] ||
    [[ "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 || "$mcp_tunnel_selected" -eq 1 ||
       "$mcp_detach" -eq 1 || "$mcp_json" -eq 1 || "$mcp_mode_selected" -eq 1 ]]; }; then
  echo "MCP session commands cannot be combined with start, status, or stop options." >&2
  exit 1
fi

if [[ "$cmd" == "mcp" && ( "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 ) ]] &&
  { [[ "$mcp_mode_selected" -eq 1 ]] || [[ -n "$mcp_port" ]] ||
    [[ "$mcp_local_selected" -eq 1 ]] || [[ "$mcp_tunnel_selected" -eq 1 ]] ||
    [[ "$mcp_detach" -eq 1 ]]; }; then
  echo "MCP transport, mode, and port options cannot be combined with --status or --stop." >&2
  exit 1
fi

if [[ "$cmd" == "mcp" && -n "$instance_arg" ]]; then
  echo "mcp does not support --instance; one MCP process is allowed per workspace." >&2
  exit 1
fi

if [[ "$cmd" == "serve" && "$NETWORK_MODE" != "host" ]]; then
  echo "ai-sandbox serve requires host networking for loopback-only SSH forwarding." >&2
  exit 1
fi

if [[ "$cmd" == "mcp" ]]; then
  if [[ "$network_selected" -eq 1 && "$NETWORK_MODE" != bridge ]]; then
    echo "ai-sandbox mcp uses bridge networking; host networking is unavailable." >&2
    exit 1
  fi
  NETWORK_MODE=bridge
  if [[ -n "$mcp_port" || "$mcp_local_selected" -eq 1 ]]; then
    echo "MCP uses stdio through Secure Tunnel; --port and --local are unavailable." >&2
    exit 1
  fi
  if [[ "$mcp_mode_selected" -eq 1 ]]; then
    echo "Winx stdio exposes Bash; --read-only and --ship are unavailable." >&2
    exit 1
  fi
  if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 && "$mcp_sessions" -eq 0 && -z "$mcp_attach_id" && "$mcp_tunnel_selected" -eq 0 ]]; then
    echo "Start Winx MCP with: ais mcp --tunnel" >&2
    exit 1
  fi
fi

if [[ "$android_mode" -eq 1 && "$NETWORK_MODE" != "host" ]]; then
  echo "Android modes require host networking for 127.0.0.1 adb access." >&2
  exit 1
fi

if [[ "$android_gpu" -eq 1 && "$emulator_mode" -ne 1 ]]; then
  echo "--android-gpu requires --emulator." >&2
  exit 1
fi

case "$NETWORK_MODE" in
  host|bridge) ;;
  *)
    echo "Invalid network mode: $NETWORK_MODE (expected host or bridge)" >&2
    exit 1
    ;;
esac

if ! [[ "$auto_reconnect" =~ ^[01]$ ]]; then
  echo "Invalid auto reconnect value: $auto_reconnect (expected 0 or 1)" >&2
  exit 1
fi

if ! [[ "$auto_reconnect_interval" =~ ^[0-9]+$ ]] || [[ "$auto_reconnect_interval" -lt 2 ]]; then
  echo "Invalid --auto-reconnect-interval value: $auto_reconnect_interval (expected integer >= 2)" >&2
  exit 1
fi

if [[ "$android_mode" -eq 1 ]]; then
  ensure_android_state_dir
fi

if [[ "$emulator_mode" -eq 1 && "$cmd" != "android-doctor" ]]; then
  require_emulator_access
fi

if [[ "$cmd" == "start" || "$cmd" == "shell" || "$cmd" == "warm" ]]; then
  ensure_vscode_url_handler
fi

if [[ "$cmd" != "logs" ]] && [[ "$logs_follow" -eq 1 ]]; then
  echo "-f/--follow is only valid with the logs command." >&2
  exit 1
fi

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  build-base)
    podman build -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
    exit 0
    ;;
  build)
    podman build -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
    exit 0
    ;;
  rebuild)
    echo "Rebuilding $IMAGE without removing existing containers..."
    podman build --no-cache -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
    exit 0
    ;;
  logs)
    if [[ -n "${workspace:-}" && -d "$workspace" ]]; then
      workspace="$(realpath "$workspace")"
      target_container="$(pick_running_container_for_workspace "$workspace")"
      [[ -n "${target_container:-}" ]] || target_container="$(pick_running_container)"
    else
      target_container="$(pick_running_container)"
    fi

    [[ -n "${target_container:-}" ]] || { echo "No AI sandbox container found." >&2; exit 1; }
    if [[ "$logs_follow" -eq 1 ]]; then
      exec podman logs -f "$target_container"
    else
      exec podman logs "$target_container"
    fi
    ;;
  doctor-net)
    if [[ -n "${workspace:-}" && -d "$workspace" ]]; then
      workspace="$(realpath "$workspace")"
      target_container="$(pick_running_container_for_workspace "$workspace")"
      [[ -n "${target_container:-}" ]] || target_container="$(pick_running_container)"
    else
      target_container="$(pick_running_container)"
    fi

    [[ -n "${target_container:-}" ]] || { echo "No AI sandbox container found." >&2; exit 1; }
    container_mode="$(container_network_mode "$target_container")"
    host_default_route="$(ip route show default 2>/dev/null | head -n1 || true)"
    host_dns="$(awk '/^nameserver /{print $2}' /etc/resolv.conf 2>/dev/null | xargs || true)"
    container_dns="$(podman exec "$target_container" /bin/bash -lc "awk '/^nameserver /{print \\$2}' /etc/resolv.conf | xargs" 2>/dev/null || true)"
    container_proxy="$(podman exec "$target_container" /bin/bash -lc "env | grep -Ei '^(http|https|no)_proxy='" 2>/dev/null || true)"

    dns_status="fail"
    ip_status="fail"
    if probe_container_dns "$target_container"; then dns_status="ok"; fi
    if probe_container_https_ip "$target_container"; then ip_status="ok"; fi

    echo "AI_SANDBOX_NET_DOCTOR: container=$target_container mode=$container_mode"
    echo "AI_SANDBOX_NET_DOCTOR: host_default_route=${host_default_route:-<none>}"
    echo "AI_SANDBOX_NET_DOCTOR: host_nameservers=${host_dns:-<none>}"
    echo "AI_SANDBOX_NET_DOCTOR: container_nameservers=${container_dns:-<none>}"
    echo "AI_SANDBOX_NET_DOCTOR: container_dns_probe=$dns_status container_ip_probe=$ip_status"
    if [[ -n "$container_proxy" ]]; then
      echo "AI_SANDBOX_NET_DOCTOR: container_proxy_env:"
      echo "$container_proxy"
    else
      echo "AI_SANDBOX_NET_DOCTOR: container_proxy_env=<none>"
    fi

    if [[ "$dns_status" == "ok" ]]; then
      echo "AI_SANDBOX_NET_DOCTOR: result=healthy"
      exit 0
    fi
    if [[ "$ip_status" == "ok" ]]; then
      echo "AI_SANDBOX_NET_DOCTOR: result=dns-broken (try: ai-sandbox reconnect-network ${workspace:-.})"
      exit 2
    fi
    echo "AI_SANDBOX_NET_DOCTOR: result=network-broken"
    exit 1
    ;;
  reconnect-network)
    if [[ -n "${workspace:-}" && -d "$workspace" ]]; then
      workspace="$(realpath "$workspace")"
      target_container="$(pick_running_container_for_workspace "$workspace")"
      [[ -n "${target_container:-}" ]] || target_container="$(pick_running_container)"
    else
      target_container="$(pick_running_container)"
    fi

    [[ -n "${target_container:-}" ]] || { echo "No AI sandbox container found." >&2; exit 1; }
    reconnect_container_network "$target_container" "manual"
    exit $?
    ;;
  reset-container)
    if [[ "$reset_all_containers" -eq 1 ]]; then
      mapfile -t sandbox_containers < <(podman ps -a --filter label=ai-sandbox=true --format '{{.Names}}')
    else
      workspace="$(realpath "$workspace")"
      mapfile -t sandbox_containers < <(podman ps -a --filter "label=ai-sandbox.workspace=$workspace" --format '{{.Names}}')
    fi

    if [[ ${#sandbox_containers[@]} -gt 0 ]]; then
      podman rm -f "${sandbox_containers[@]}" >/dev/null
      echo "Removed containers: ${sandbox_containers[*]}"
    else
      echo "No matching sandbox containers to remove."
    fi
    exit 0
    ;;
  reset-storage|reset-volumes)
    # Stop/remove running AI sandbox containers first so storage can be removed.
    mapfile -t sandbox_containers < <(podman ps -aq --filter label=ai-sandbox=true)
    if [[ ${#sandbox_containers[@]} -gt 0 ]]; then
      podman rm -f "${sandbox_containers[@]}" >/dev/null
    fi

    for storage in "$NIX_STORAGE" "$HOME_STORAGE" "$ANDROID_STATE_DIR"; do
      if [[ "$storage" == /* ]]; then
        case "$storage" in
          "/"|"")
            echo "Refusing to reset unsafe storage path: $storage" >&2
            exit 1
            ;;
        esac
        rm -rf -- "$storage"
        mkdir -p -- "$storage"
      else
        if podman volume exists "$storage"; then
          podman volume rm -f "$storage" >/dev/null
        fi
      fi
    done

    echo "Reset storage: $NIX_STORAGE, $HOME_STORAGE, $ANDROID_STATE_DIR"
    exit 0
    ;;
  repair-nix)
    selinux_label_opt="$(selinux_mount_label_opt)"
    home_mount_spec="$(storage_mount_spec "$HOME_STORAGE" /sandbox-home "$selinux_label_opt")"
    nix_mount_spec="$(storage_mount_spec "$NIX_STORAGE" /nix "$selinux_label_opt")"

    exec podman run --rm -it \
      --userns=keep-id \
      --user "$(id -u):$(id -g)" \
      --group-add keep-groups \
      --label ai-sandbox=true \
      -e HOME=/sandbox-home \
      -e XDG_RUNTIME_DIR=/tmp/xdg-runtime \
      -e AI_SANDBOX_MODE=repair \
      -v "$home_mount_spec" \
      -v "$nix_mount_spec" \
      "$IMAGE"
    ;;
  prune)
    run_prune
    exit $?
    ;;
  agents)
    [[ -n "$sync_mode" ]] || { echo "agents requires pull, push, reset, or clear" >&2; exit 1; }
    run_agents_sync "$sync_mode" "$sync_path_arg"
    exit 0
    ;;
  skills)
    [[ -n "$sync_mode" ]] || { echo "skills requires pull or push" >&2; exit 1; }
    run_skills_sync "$sync_mode" "$sync_path_arg"
    exit 0
    ;;
  open-url)
    [[ -n "$open_url_arg" ]] || { echo "open-url requires a URL" >&2; exit 1; }
    container="$(pick_running_container)"
    if [[ -n "$container" ]]; then
      exec podman exec "$container" /usr/local/bin/ai-sandbox-open-url "$open_url_arg"
    fi
    exec code --open-url "$open_url_arg"
    echo "No running AI sandbox container found, and host VS Code failed to handle --open-url." >&2
    exit 1
    ;;
  open-in-editor)
    [[ -n "$open_editor_file" ]] || { echo "open-in-editor requires FILE [LINE] [COLUMN]" >&2; exit 1; }
    if ! [[ -z "$open_editor_line" || "$open_editor_line" =~ ^[0-9]+$ ]]; then
      echo "LINE must be numeric: $open_editor_line" >&2
      exit 1
    fi
    if ! [[ -z "$open_editor_col" || "$open_editor_col" =~ ^[0-9]+$ ]]; then
      echo "COLUMN must be numeric: $open_editor_col" >&2
      exit 1
    fi

    target="$open_editor_file"
    if [[ -n "$open_editor_line" && -n "$open_editor_col" ]]; then
      target="${target}:${open_editor_line}:${open_editor_col}"
    elif [[ -n "$open_editor_line" ]]; then
      target="${target}:${open_editor_line}"
    fi

    container="$(pick_running_container_for_file "$open_editor_file" || true)"
    [[ -n "$container" ]] || container="$(pick_running_container)"
    if [[ -n "$container" ]]; then
      target="$(map_host_target_for_container "$container" "$target")"
      exec podman exec "$container" bash -lc '
        editor_bin="$(command -v code || true)"
        if [[ -z "$editor_bin" ]]; then
          echo "No VS Code binary found inside sandbox container." >&2
          exit 127
        fi

        exec "$editor_bin" \
          --user-data-dir "${AI_SANDBOX_VSCODE_USER_DATA_DIR:-/sandbox-home/.vscode-data}" \
          --extensions-dir "${AI_SANDBOX_VSCODE_EXTENSIONS_DIR:-/sandbox-home/.vscode-extensions}" \
          --goto "$1"
      ' _ "$target"
    fi

    exec code --goto "$target"
    ;;
esac

case "$cmd" in
  start|shell|warm|exec|install|repair-nix|android-doctor)
    ensure_image_exists
    ;;
  serve)
    [[ "$server_stop" -eq 1 ]] || ensure_image_exists
    ;;
  mcp)
    if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 &&
      "$mcp_sessions" -eq 0 && -z "$mcp_attach_id" ]]; then
      ensure_image_exists
    fi
    ;;
esac

[[ -d "$workspace" ]] || { echo "Workspace does not exist: $workspace" >&2; exit 1; }
project_name="$(basename "$workspace")"
selinux_label_opt="$(selinux_mount_label_opt)"

home_mount_spec=""
nix_mount_spec=""
if [[ "$HOME_STORAGE" == /* ]]; then
  mkdir -p "$HOME_STORAGE"
  home_mount_spec="$HOME_STORAGE:/sandbox-home${selinux_label_opt}"
else
  home_mount_spec="$HOME_STORAGE:/sandbox-home${selinux_label_opt},U"
fi

if [[ "$NIX_STORAGE" == /* ]]; then
  mkdir -p "$NIX_STORAGE"
  nix_mount_spec="$NIX_STORAGE:/nix${selinux_label_opt}"
else
  nix_mount_spec="$NIX_STORAGE:/nix${selinux_label_opt},U"
fi

mount_root="$workspace"
container_workspace="/workspace"

# Preserve parent directory depth for submodule workspaces by mounting the top
# superproject root and opening the requested workspace path underneath it.
if command -v git >/dev/null 2>&1 && git -C "$workspace" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  probe="$workspace"
  while true; do
    superproject="$(git -C "$probe" rev-parse --show-superproject-working-tree 2>/dev/null || true)"
    [[ -n "$superproject" ]] || break
    probe="$(realpath "$superproject")"
  done

  if [[ "$probe" != "$workspace" ]]; then
    mount_root="$probe"
    workspace_rel="$(realpath --relative-to="$mount_root" "$workspace")"
    container_workspace="/workspace/$workspace_rel"
  fi
fi

if [[ "$cmd" == "mcp" ]]; then
  mcp_require_home_path
  if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 && "$mount_root" != "$workspace" ]]; then
    echo "ai-sandbox mcp cannot expose a submodule through an expanded parent mount." >&2
    echo "Run it from the top-level mounted repository instead: $mount_root" >&2
    exit 1
  fi
  if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 && "$mcp_tunnel_selected" -eq 1 ]]; then
    mcp_resolve_tunnel_credentials \
      "$mcp_tunnel_id" \
      mcp_tunnel_id \
      mcp_runtime_api_key
  fi
fi

flake_arg_container="${flake_arg:-}"
if [[ -n "${flake_arg:-}" ]]; then
  if [[ "$flake_arg" == "$mount_root" || "$flake_arg" == "$mount_root/"* ]]; then
    flake_rel="$(realpath --relative-to="$mount_root" "$flake_arg")"
    if [[ "$flake_rel" == "." ]]; then
      flake_arg_container="/workspace"
    else
      flake_arg_container="/workspace/$flake_rel"
    fi
  fi
fi

workspace_hash="$(echo -n "$workspace" | sha256sum | cut -c1-12)"
project_slug="$(sanitize_container_name_part "$project_name" "workspace")"
launch_context="vscode"
if [[ "$cmd" == "shell" || "$cmd" == "warm" || "$cmd" == "exec" ]]; then
  launch_context="shell"
elif [[ "$cmd" == "serve" ]]; then
  launch_context="code-server"
elif [[ "$cmd" == "mcp" ]]; then
  launch_context="mcp"
elif [[ "$cmd" == "android-doctor" ]]; then
  launch_context="android-doctor"
fi

runtime_profile="default"
if [[ "$emulator_mode" -eq 1 ]]; then
  runtime_profile="emulator"
  [[ "$android_gpu" -eq 1 ]] && runtime_profile="emulator-gpu"
elif [[ "$android_mode" -eq 1 ]]; then
  runtime_profile="android"
fi

base_container_name="ai-sandbox-${project_slug}-${launch_context}-${workspace_hash}"
if [[ "$runtime_profile" != "default" ]]; then
  base_container_name="$base_container_name-$runtime_profile"
fi
if [[ -n "$instance_arg" ]]; then
  container_name="$base_container_name-$instance_arg"
else
  if [[ "$cmd" == "shell" ]]; then
    instance_arg="$(pick_auto_instance_name "$base_container_name")"
  else
    instance_arg="default"
  fi
  container_name="$base_container_name-$instance_arg"
fi

if [[ "$cmd" == "serve" && "$server_stop" -eq 1 ]]; then
  if podman inspect "$container_name" >/dev/null 2>&1; then
    podman stop "$container_name" >/dev/null
    echo "Stopped code-server container $container_name."
  else
    echo "No code-server container found for $workspace (instance=$instance_arg)."
  fi
  exit 0
fi
if [[ "$cmd" == "mcp" && "$mcp_status" -eq 1 ]]; then
  mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
  exit 0
fi

if [[ "$cmd" == "mcp" && "$mcp_stop" -eq 1 ]]; then
  mcp_stop_rc=0
  mcp_stop_process "$container_name" "$workspace_hash" "$mcp_json" || mcp_stop_rc=$?
  if [[ "$mcp_json" -eq 1 ]]; then
    mcp_emit_status "$workspace" "$container_name" "$workspace_hash" 1
  fi
  exit "$mcp_stop_rc"
fi

if [[ "$cmd" == "mcp" && "$mcp_sessions" -eq 1 ]]; then
  if ! container_is_running "$container_name"; then
    echo "MCP container is not running." >&2
    exit 1
  fi
  podman exec "$container_name" \
    "/sandbox-home/.local/share/ai-sandbox/mcp/winx/$AI_SANDBOX_MCP_VERSION/winx-code-agent" list
  echo "Follow one with: ais mcp --attach THREAD_ID"
  exit 0
fi

if [[ "$cmd" == "mcp" && -n "$mcp_attach_id" ]]; then
  if ! container_is_running "$container_name"; then
    echo "MCP container is not running." >&2
    exit 1
  fi
  exec podman exec -it "$container_name" \
    "/sandbox-home/.local/share/ai-sandbox/mcp/winx/$AI_SANDBOX_MCP_VERSION/winx-code-agent" \
    attach "$mcp_attach_id" --follow
fi

code_server_port=""
if [[ "$cmd" == "serve" ]]; then
  code_server_port="$(resolve_code_server_port "$workspace_hash" "$instance_arg" "$container_name" "$server_port")"
fi

if [[ "$cmd" != "mcp" ]]; then
  echo "$container_name" > "$STATE_DIR/last-container"
fi

# Keep process/cache/webview data per instance to avoid Chromium profile
# collisions, while sharing user-level settings/extensions for a desktop-like
# experience across sandbox instances.
vscode_profile_id="${workspace_hash}-${instance_arg}"
vscode_user_data_dir="/sandbox-home/.vscode-data/instances/$vscode_profile_id"
vscode_extensions_dir="/sandbox-home/.vscode-extensions/shared"
vscode_shared_user_dir="/sandbox-home/.vscode-shared-user"
code_server_user_data_dir="/sandbox-home/.code-server-data/instances/$vscode_profile_id"
code_server_extensions_dir="/sandbox-home/.code-server-extensions/shared"

theme="$(detect_theme)"

host_dbus_args=()
x11_args=()
if [[ "$cmd" != "install" && "$cmd" != "serve" && "$cmd" != "mcp" && "$cmd" != "android-doctor" ]]; then
  xauth_file="${XAUTHORITY:-$HOME/.Xauthority}"
  if [[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]]; then
    x11_args+=(
      -e "DISPLAY=$DISPLAY"
      -v /tmp/.X11-unix:/tmp/.X11-unix:ro
    )

    if [[ -f "$xauth_file" ]]; then
      x11_args+=(
        -e XAUTHORITY=/tmp/.Xauthority
        -v "$xauth_file:/tmp/.Xauthority:ro"
      )
    else
      echo "Warning: Xauthority file not found ($xauth_file); continuing without Xauthority mount." >&2
    fi
  fi

  if [[ -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/bus" ]]; then
    host_dbus_args=(
      -e "AI_SANDBOX_HOST_DBUS_SESSION_BUS_ADDRESS=unix:path=/host-run-user-bus"
      -v "${XDG_RUNTIME_DIR}/bus:/host-run-user-bus:rw"
    )
  fi
fi

container_mode="$cmd"
[[ "$cmd" == "serve" ]] && container_mode="server"
[[ "$cmd" == "mcp" ]] && container_mode="idle"

mcp_mount_args=()
if [[ "$cmd" == "mcp" ]]; then
  mcp_runtime_host="$(mcp_runtime_host_dir "$workspace_hash")"
  mkdir -p "$mcp_runtime_host/runtime"
  chmod 0700 "$mcp_runtime_host"
  home_mount_spec="$mcp_runtime_host:/sandbox-home${selinux_label_opt}"
fi

android_args=()
emulator_device_args=()
if [[ "$android_mode" -eq 1 ]]; then
  android_args=(
    -e ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
    -e AI_SANDBOX_ANDROID_MODE=1
    -e ANDROID_USER_HOME=/android-state/user
    -e ANDROID_AVD_HOME=/android-state/avd
    -e ANDROID_EMULATOR_HOME=/android-state/emulator
    -v "$ANDROID_STATE_DIR:/android-state${selinux_label_opt}"
  )
fi

if [[ "$emulator_mode" -eq 1 ]]; then
  android_args+=(
    -e AI_SANDBOX_EMULATOR_MODE=1
  )
  if [[ "$cmd" != "android-doctor" || -e /dev/kvm ]]; then
    emulator_device_args+=(--device=/dev/kvm)
  fi
  if [[ "$android_gpu" -eq 1 && ( "$cmd" != "android-doctor" || -e /dev/dri ) ]]; then
    emulator_device_args+=(--device=/dev/dri)
  fi
fi

common_args=(
  --name "$container_name"
  --init
  --userns=keep-id
  --user "$(id -u):$(id -g)"
  --group-add keep-groups
  --label ai-sandbox=true
  --label "ai-sandbox.workspace=$workspace"
  --label "ai-sandbox.workspace-hash=$workspace_hash"
  --label "ai-sandbox.instance=$instance_arg"
  --label "ai-sandbox.profile=$runtime_profile"
  -e HOME=/sandbox-home
  -e CODEX_HOME=/sandbox-home/.codex
  -e XDG_RUNTIME_DIR=/tmp/xdg-runtime
  -e "AI_SANDBOX_MODE=$container_mode"
  -e "AI_SANDBOX_FLAKE=$flake_arg_container"
  -e "AI_SANDBOX_WORKSPACE=$container_workspace"
  -e "AI_SANDBOX_HOST_MOUNT_ROOT=$mount_root"
  -e "AI_SANDBOX_CONTAINER_MOUNT_ROOT=/workspace"
  -e "AI_SANDBOX_PROJECT_NAME=$project_name"
  -e "AI_SANDBOX_INSTANCE_NAME=$instance_arg"
  -e "AI_SANDBOX_NETWORK_MODE=$NETWORK_MODE"
  -e "AI_SANDBOX_THEME=$theme"
  -e "AI_SANDBOX_VSCODE_USER_DATA_DIR=$vscode_user_data_dir"
  -e "AI_SANDBOX_VSCODE_EXTENSIONS_DIR=$vscode_extensions_dir"
  -e "AI_SANDBOX_VSCODE_SHARED_USER_DIR=$vscode_shared_user_dir"
  -e "AI_SANDBOX_CODE_SERVER_USER_DATA_DIR=$code_server_user_data_dir"
  -e "AI_SANDBOX_CODE_SERVER_EXTENSIONS_DIR=$code_server_extensions_dir"
  -e "AI_SANDBOX_CODE_SERVER_PORT=$code_server_port"
  -v "$mount_root:/workspace${selinux_label_opt}"
  -v "$home_mount_spec"
  -v "$nix_mount_spec"
  "${mcp_mount_args[@]}"
  "${android_args[@]}"
  "${emulator_device_args[@]}"
  "${x11_args[@]}"
)

network_args=()
if [[ "$NETWORK_MODE" == "host" ]]; then
  network_args=(--network host)
fi

run_android_doctor() {
  echo "Running Android diagnostics in a temporary sandbox..."
  exec podman run --rm -it \
    "${common_args[@]}" \
    "${network_args[@]}" \
    "${host_dbus_args[@]}" \
    "$IMAGE"
}

run_detached() {
  local mode existing_state
  existing_state="$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)"

  if [[ "$existing_state" == "running" ]]; then
    echo "Sandbox container already running: $container_name"
  elif [[ -n "$existing_state" ]]; then
    echo "Starting existing sandbox container $container_name..."
    podman start "$container_name" >/dev/null
  else
    echo "Starting sandbox container $container_name..."
    podman run -d \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE" >/dev/null
    echo "Started $container_name"
  fi

  mode="$(container_network_mode "$container_name")"
  if [[ "$auto_reconnect" == "1" ]]; then
    maybe_start_auto_reconnect_watcher "$container_name" "$mode" "$auto_reconnect_interval"
  else
    echo "Auto-reconnect watcher disabled."
  fi
  if [[ "$cmd" == "serve" ]]; then
    wait_for_code_server "$container_name" "$code_server_port"
  else
    follow_startup_logs_until_vscode "$container_name"
  fi
  if [[ "$follow_logs_on_start" -eq 1 ]]; then
    echo "Continuing to follow logs for $container_name (Ctrl-C to stop following; container keeps running)..."
    podman logs -f --tail 0 "$container_name"
  fi
}

run_interactive() {
  if [[ "$cmd" == "warm" ]]; then
    echo "Starting warmup container..."
    podman run --rm -it \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE"
  fi
}

run_shell() {
  echo "Starting fresh sandbox container $container_name..."
  if [[ ${#shell_command[@]} -gt 0 ]]; then
    exec podman run --rm -it \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE" "${shell_command[@]}"
  fi

  exec podman run --rm -it \
    "${common_args[@]}" \
    "${network_args[@]}" \
    "${host_dbus_args[@]}" \
    "$IMAGE"
}

run_exec() {
  local existing_container existing_workspace existing_state

  existing_container="$(pick_running_container_for_workspace "$workspace" "$runtime_profile" || true)"
  if [[ -n "$existing_container" ]]; then
    echo "Reusing running sandbox container $existing_container..."
    if [[ "$auto_reconnect" == "1" ]]; then
      reconnect_container_network "$existing_container" "pre-exec" || true
    fi
    existing_workspace="$(container_workspace_from_env "$existing_container")"
    echo "Running command in sandbox workspace $existing_workspace: ${exec_command[*]}"
    exec podman exec -it "$existing_container" /bin/bash -lc 'cd "$1"; shift; exec "$@"' _ "$existing_workspace" "${exec_command[@]}"
  fi

  existing_state="$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)"
  if [[ -n "$existing_state" && "$existing_state" != "running" ]]; then
    echo "Starting existing sandbox container $container_name for exec..."
    podman start "$container_name" >/dev/null
  elif [[ -z "$existing_state" ]]; then
    echo "No sandbox container found for workspace; creating persistent container..."
    podman run -d \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE" >/dev/null
  fi

  echo "Running command: ${exec_command[*]}"
  exec podman exec -it "$container_name" /bin/bash -lc 'cd "$1"; shift; exec "$@"' _ "$container_workspace" "${exec_command[@]}"
}

run_mcp() {
  local existing_state actual_network runtime_dir lock_file tunnel_json existing_mode existing_version legacy_container new_tunnel=0
  runtime_dir="$(mcp_runtime_host_dir "$workspace_hash")"
  lock_file="$runtime_dir/runtime/lock"
  mkdir -p "$(dirname "$lock_file")"
  exec 8>"$lock_file"
  if ! flock -w 2 8; then
    echo "Another MCP operation is already in progress for this workspace." >&2
    echo "Wait for it to finish, or stop the stuck process before retrying." >&2
    return 1
  fi

  legacy_container="ai-sandbox-${project_slug}-workspace-${workspace_hash}-default"
  existing_state="$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)"
  if [[ "$existing_state" == "running" ]]; then
    echo "Reusing sandbox workspace container $container_name..." >&2
  elif [[ -n "$existing_state" ]]; then
    echo "Starting sandbox workspace container $container_name..." >&2
    podman start "$container_name" >/dev/null
  else
    echo "Creating sandbox workspace container $container_name..." >&2
    podman run -d \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "$IMAGE" >/dev/null
  fi

  actual_network="$(podman inspect -f '{{.HostConfig.NetworkMode}}' "$container_name")"
  if [[ "$actual_network" == host ]]; then
    echo "MCP container uses host networking; recreate it with bridge networking." >&2
    return 1
  fi
  tunnel_json="$(mcp_tunnel_status_json \
    "$container_name" "$runtime_dir" \
    "$(mcp_runtime_container_dir "$workspace_hash")")"
  existing_mode="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" mode)"
  existing_version="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" version)"
  if [[ "$(jq -r '.process_running' <<<"$tunnel_json")" == true &&
    -n "$existing_version" && "$existing_version" != "$AI_SANDBOX_MCP_VERSION" ]]; then
    echo "MCP is running Winx $existing_version; stop it before upgrading." >&2
    return 1
  fi
  if [[ "$(jq -r '.process_running' <<<"$tunnel_json")" == true &&
    -n "$existing_mode" && "$existing_mode" != "$mcp_mode" ]]; then
    echo "MCP is already running with mode=$existing_mode." >&2
    echo "Stop it before changing mode." >&2
    return 1
  fi
  if [[ "$(jq -r '.process_running' <<<"$tunnel_json")" != true ]]; then
    new_tunnel=1
    trap 'trap - INT TERM HUP; mcp_stop_process "$container_name" "$workspace_hash" 1 || true; exit 130' INT
    trap 'trap - INT TERM HUP; mcp_stop_process "$container_name" "$workspace_hash" 1 || true; exit 143' TERM
    trap 'trap - INT TERM HUP; mcp_stop_process "$container_name" "$workspace_hash" 1 || true; exit 129' HUP
  fi
  if ! mcp_start_tunnel \
    "$container_name" "$workspace_hash" \
    "$mcp_tunnel_id" "$mcp_runtime_api_key" \
    "$legacy_container"; then
    trap - INT TERM HUP
    [[ "$new_tunnel" -eq 0 ]] || mcp_stop_process "$container_name" "$workspace_hash" 1 || true
    return 1
  fi
  mcp_write_metadata \
    "$runtime_dir/runtime/metadata.json" \
    "$(mcp_container_id "$container_name")" "$mcp_mode"
  if ! mcp_store_tunnel_credentials \
    "$mcp_tunnel_id" "$mcp_runtime_api_key"; then
    trap - INT TERM HUP
    [[ "$new_tunnel" -eq 0 ]] || mcp_stop_process "$container_name" "$workspace_hash" 1 || true
    return 1
  fi
  mcp_runtime_api_key=""
  mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
  if [[ "$mcp_tunnel_selected" -eq 1 && "$mcp_detach" -eq 0 ]]; then
    flock -u 8
    mcp_supervise_tunnel "$container_name" "$workspace_hash"
  fi
  trap - INT TERM HUP
}

run_install() {
  local existing_container install_args=()
  local start_ts launch_ts run_start_ts run_end_ts
  local -a podman_cmd
  local podman_rc=0
  start_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"

  echo "[ai-sandbox][install][$start_ts] Starting install flow for workspace: $workspace"
  echo "[ai-sandbox][install][$start_ts] Image: $IMAGE | Network: $NETWORK_MODE"
  if [[ -n "$selinux_label_opt" ]]; then
    echo "[ai-sandbox][install][$start_ts] Mount labeling: enabled ($selinux_label_opt)"
  else
    echo "[ai-sandbox][install][$start_ts] Mount labeling: disabled (SELinux not enabled)"
  fi

  if [[ "$install_force" -eq 1 ]]; then
    install_args+=(--force)
  fi
  install_args+=(--only "$install_only")
  echo "[ai-sandbox][install][$start_ts] Install options: ${install_args[*]}"

  echo "[ai-sandbox][install][$start_ts] Checking for an already running sandbox container..."
  existing_container="$(pick_running_container_for_workspace "$workspace" || true)"
  if [[ -n "$existing_container" ]]; then
    echo "[ai-sandbox][install][$start_ts] Reusing running sandbox container: $existing_container"
    echo "[ai-sandbox][install][$start_ts] Executing install script inside existing container..."
    exec podman exec -it "$existing_container" /usr/local/bin/ai-sandbox-default-install "${install_args[@]}"
  fi

  launch_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  echo "[ai-sandbox][install][$launch_ts] No running sandbox found for workspace."
  echo "[ai-sandbox][install][$launch_ts] Starting temporary container for install..."
  echo "[ai-sandbox][install][$launch_ts] If this step is slow, storage or container startup is likely the bottleneck."
  echo "[ai-sandbox][install][$launch_ts] Podman store info:"
  podman info --format '[ai-sandbox][install] graphDriver={{.Store.GraphDriverName}} graphRoot={{.Store.GraphRoot}} runRoot={{.Store.RunRoot}}' 2>/dev/null || \
    echo "[ai-sandbox][install][$launch_ts] podman info unavailable"
  echo "[ai-sandbox][install][$launch_ts] Launching: podman run --rm -it ... /usr/local/bin/ai-sandbox-default-install ${install_args[*]}"

  podman_cmd=(podman)
  if [[ "${AI_SANDBOX_PODMAN_DEBUG:-0}" == "1" ]]; then
    echo "[ai-sandbox][install][$launch_ts] Podman debug mode enabled (AI_SANDBOX_PODMAN_DEBUG=1)."
    podman_cmd+=(--log-level=debug)
  fi

  run_start_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  echo "[ai-sandbox][install][$run_start_ts] Executing podman run now..."
  "${podman_cmd[@]}" run --rm -it \
    "${common_args[@]}" \
    "${network_args[@]}" \
    "${host_dbus_args[@]}" \
    -e AI_SANDBOX_MODE=exec \
    "$IMAGE" /usr/local/bin/ai-sandbox-default-install "${install_args[@]}" || podman_rc=$?
  run_end_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  echo "[ai-sandbox][install][$run_end_ts] podman run exited with code: $podman_rc"
  return "$podman_rc"
}

case "$cmd" in
  start) run_detached ;;
  serve) run_detached ;;
  mcp) run_mcp ;;
  shell) run_shell ;;
  warm) run_interactive ;;
  exec) run_exec ;;
  android-doctor) run_android_doctor ;;
  install) run_install ;;
  *) usage >&2; exit 1 ;;
esac
