        elif [[ -z "$open_editor_line" ]]; then
          open_editor_line="$1"
        elif [[ -z "$open_editor_col" ]]; then
          open_editor_col="$1"
        else
          echo "open-in-editor accepts at most FILE [LINE] [COLUMN]" >&2
          exit 1
        fi
      elif [[ "$cmd" == "mcp" ]]; then
        if [[ "$mcp_gateway_mode" -eq 1 ]]; then
          if [[ -z "$mcp_gateway_cmd" ]]; then
            mcp_gateway_cmd="$1"
            shift
            continue
          fi
          if [[ "$mcp_gateway_cmd" == publish && "$1" == cloudflare ]]; then
            mcp_gateway_publisher=cloudflare
            shift
            continue
          fi
          echo "mcp gateway accepts exactly one subcommand." >&2
          exit 1
        fi
        if [[ "$workspace_explicit" -eq 0 && "$mcp_slots_mode" -eq 0 && "$1" == "gateway" ]]; then
          mcp_gateway_mode=1
          shift
          continue
        fi
        if [[ "$workspace_explicit" -eq 0 && "$mcp_slots_mode" -eq 0 && "$1" == "slots" ]]; then
          mcp_slots_mode=1
          shift
          continue
        fi
        [[ "$workspace_explicit" -eq 0 ]] || {
          echo "mcp accepts at most one WORKSPACE argument." >&2
          exit 1
        }
        workspace="$(realpath "$1")"
        workspace_explicit=1
      else
        workspace="$(realpath "$1")"
      fi
      shift
      ;;
  esac
done

if [[ "$cmd" == "exec" && ${#exec_command[@]} -eq 0 ]]; then
