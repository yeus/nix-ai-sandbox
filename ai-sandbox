  exit 1
fi
if [[ -n "$mcp_connection" && ! "$mcp_connection" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$ ]]; then
  echo "Invalid MCP connection name: $mcp_connection (expected 1-32 letters, digits, ., _, or -)." >&2
  exit 1
fi
if [[ -n "$mcp_connection" && "$mcp_transport_count" -eq 0 ]]; then
  echo "mcp --connection requires --local, --tunnel, or --publish." >&2
  exit 1
fi

if [[ -n "$mcp_tunnel_id" && ! "$mcp_tunnel_id" =~ ^tunnel_[a-z0-9]{32}$ ]]; then
  echo "Invalid --tunnel value: expected tunnel_<32 lowercase letters or digits>." >&2
  exit 1
fi

if [[ "$mcp_share_home" -eq 1 && "$mcp_tunnel_selected" -ne 1 ]]; then
  echo "mcp --share-home requires --tunnel." >&2
  exit 1
fi

if [[ -n "$mcp_slot" && ! "$mcp_slot" =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid --slot value: $mcp_slot (expected an integer >= 1)." >&2
  exit 1
fi
if [[ "$mcp_takeover_slot" -eq 1 && -z "$mcp_slot" ]]; then
  echo "mcp --takeover-slot requires --slot." >&2
  exit 1
fi
if [[ -n "$mcp_gateway_slots" && ! "$mcp_gateway_slots" =~ ^[1-9][0-9]?$ ]]; then
  echo "Invalid gateway slot count: $mcp_gateway_slots (expected 1-99)." >&2
  exit 1
fi

if [[ "$mcp_unslot" -eq 1 ]] &&
  { [[ "$mcp_transport_count" -ne 0 ]] || [[ -n "$mcp_slot" ]] ||
    [[ "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 || "$mcp_sessions" -eq 1 ||
       -n "$mcp_attach_id" || "$mcp_show_token" -eq 1 || "$mcp_mode_selected" -eq 1 ||
       "$mcp_json" -eq 1 ]]; }; then
  echo "mcp --unslot cannot be combined with other MCP start, status, or stop options." >&2
  exit 1
fi

if [[ "$mcp_slots_mode" -eq 1 ]] &&
  { [[ "$mcp_transport_count" -ne 0 ]] || [[ -n "$mcp_slot" ]] ||
    [[ "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 || "$mcp_sessions" -eq 1 ||
       -n "$mcp_attach_id" || "$mcp_show_token" -eq 1 || "$mcp_mode_selected" -eq 1 ]]; }; then
  echo "mcp slots cannot be combined with MCP start, status, or stop options." >&2
  exit 1
fi
if [[ "$mcp_slots_mode" -eq 1 && "$workspace_explicit" -eq 1 ]]; then
  echo "mcp slots does not accept a WORKSPACE argument." >&2
  exit 1
fi

if [[ -n "$mcp_gateway_slots" && "$mcp_gateway_mode" -ne 1 ]]; then
  echo "mcp --slots is only valid with 'mcp gateway setup'." >&2
  exit 1
fi
if [[ "$mcp_gateway_dev_insecure" -eq 1 && "$mcp_gateway_mode" -ne 1 ]]; then
  echo "mcp --dev-insecure is only valid with 'mcp gateway publish'." >&2
  exit 1
fi

if [[ "$mcp_gateway_mode" -eq 1 ]]; then
  case "$mcp_gateway_cmd" in
    setup|start|stop|status|endpoints|publish|unpublish) ;;
    *)
      echo "mcp gateway requires a subcommand: setup, start, stop, status, endpoints, publish, or unpublish." >&2
      exit 1
      ;;
  esac
  if [[ "$workspace_explicit" -eq 1 ]]; then
    echo "mcp gateway does not accept a WORKSPACE argument." >&2
    exit 1
  fi
  if [[ "$mcp_transport_count" -ne 0 || "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 ||
        "$mcp_sessions" -eq 1 || -n "$mcp_attach_id" || "$mcp_show_token" -eq 1 ||
        "$mcp_mode_selected" -eq 1 || -n "$mcp_slot" || "$mcp_unslot" -eq 1 ||
        "$mcp_slots_mode" -eq 1 || -n "$mcp_connection" ]]; then
    echo "mcp gateway cannot be combined with MCP start, status, or stop options." >&2
    exit 1
  fi
  if [[ -n "$mcp_gateway_slots" && "$mcp_gateway_cmd" != setup ]]; then
    echo "mcp gateway --slots is only valid with setup." >&2
    exit 1
  fi
  if [[ -n "$mcp_public_url" && "$mcp_gateway_cmd" != publish ]]; then
    echo "mcp gateway --public-url is only valid with publish." >&2
    exit 1
  fi
  if [[ "$mcp_gateway_dev_insecure" -eq 1 && "$mcp_gateway_cmd" != publish ]]; then
    echo "mcp gateway --dev-insecure is only valid with publish." >&2
    exit 1
  fi
fi

if [[ "$mcp_status" -eq 1 && "$mcp_stop" -eq 1 ]]; then
  echo "mcp --status and --stop are mutually exclusive." >&2
  exit 1
fi

if [[ "$mcp_detach" -eq 1 && "$mcp_tunnel_selected" -ne 1 ]]; then
  echo "mcp --detach is retained for the OpenAI --tunnel transport only." >&2
  exit 1
fi

if [[ "$mcp_show_token" -eq 1 ]] &&
  { [[ "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 || "$mcp_sessions" -eq 1 ||
       -n "$mcp_attach_id" || "$mcp_transport_count" -ne 0 ||
       "$mcp_json" -eq 1 || "$mcp_mode_selected" -eq 1 ||
       "$network_selected" -eq 1 || -n "$mcp_port" || -n "$mcp_public_url" ||
       -n "$mcp_connection" ]]; }; then
  echo "mcp --show-key/--show-token cannot be combined with other MCP operations or start options." >&2
  exit 1
fi

if [[ "$cmd" == mcp && ( "$mcp_sessions" -eq 1 || -n "$mcp_attach_id" ) ]] &&
  { [[ "$mcp_sessions" -eq 1 && -n "$mcp_attach_id" ]] ||
    [[ "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 || "$mcp_transport_count" -ne 0 ||
       "$mcp_detach" -eq 1 || "$mcp_json" -eq 1 || "$mcp_mode_selected" -eq 1 ||
       "$network_selected" -eq 1 || -n "$mcp_port" || -n "$mcp_public_url" ||
       -n "$mcp_connection" ]]; }; then
  echo "MCP session commands cannot be combined with start, status, or stop options." >&2
  exit 1
fi

if [[ "$cmd" == "mcp" && ( "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 ) ]] &&
  { [[ "$mcp_mode_selected" -eq 1 ]] || [[ -n "$mcp_port" ]] ||
    [[ "$mcp_transport_count" -ne 0 ]] || [[ "$mcp_detach" -eq 1 ]] ||
     [[ "$network_selected" -eq 1 ]] || [[ -n "$mcp_public_url" ]] ||
     [[ "$mcp_show_token" -eq 1 ]] || [[ -n "$mcp_connection" ]]; }; then
  echo "MCP start options cannot be combined with --status or --stop." >&2
  exit 1
fi

if [[ "$cmd" == "mcp" && -n "$instance_arg" ]]; then
  echo "mcp does not support --instance; one MCP process is allowed per workspace." >&2
  exit 1
fi

if [[ "$mcp_android_selected" -eq 1 ]] &&
  { [[ "$mcp_status" -eq 1 || "$mcp_stop" -eq 1 || "$mcp_sessions" -eq 1 || -n "$mcp_attach_id" ]]; }; then
  echo "MCP Android flags are only valid when starting MCP." >&2
  exit 1
fi

if [[ "$cmd" == "serve" && "$NETWORK_MODE" != "host" ]]; then
  echo "ai-sandbox serve requires host networking for loopback-only SSH forwarding." >&2
  exit 1
fi

if [[ "$cmd" == "mcp" ]]; then
  if [[ "$mcp_local_selected" -eq 1 || -n "$mcp_publish" ]]; then
    if [[ "$android_mode" -eq 1 ]]; then
      echo "HTTP MCP publishing cannot be combined with Android host networking." >&2
      exit 1
    fi
    if [[ "$network_selected" -eq 1 && "$NETWORK_MODE" != bridge ]]; then
      echo "HTTP MCP modes require isolated bridge/private networking." >&2
      exit 1
    fi
    NETWORK_MODE=bridge
  else
    mcp_expected_network=bridge
    if [[ "$android_mode" -eq 1 ]]; then
      mcp_expected_network=host
      if [[ "$network_selected" -eq 1 && "$NETWORK_MODE" != host ]]; then
        echo "MCP Android modes require host networking." >&2
        exit 1
      fi
    elif [[ "$network_selected" -eq 1 ]]; then
      mcp_expected_network="$NETWORK_MODE"
    fi
    NETWORK_MODE="$mcp_expected_network"
  fi

  if [[ "$mcp_mode_selected" -eq 1 ]]; then
    echo "Winx Bash modes --read-only and --ship are unavailable through ais mcp." >&2
    exit 1
  fi
  if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 && "$mcp_sessions" -eq 0 &&
    -z "$mcp_attach_id" && "$mcp_show_token" -eq 0 && "$mcp_transport_count" -eq 0 &&
    "$mcp_unslot" -eq 0 && "$mcp_slots_mode" -eq 0 && "$mcp_gateway_mode" -eq 0 ]]; then
    echo "Start Winx MCP with --local, --publish cloudflare, or --tunnel." >&2
    exit 1
  fi
fi

if [[ "$android_mode" -eq 1 && "$NETWORK_MODE" != "host" ]]; then
  echo "Android modes require host networking for 127.0.0.1 adb access." >&2
  exit 1
fi

if [[ "$android_gpu" -eq 1 && "$emulator_mode" -ne 1 ]]; then
  echo "--android-gpu requires --emulator." >&2
  exit 1
fi

case "$NETWORK_MODE" in
  host|bridge) ;;
  *)
    echo "Invalid network mode: $NETWORK_MODE (expected host or bridge)" >&2
    exit 1
    ;;
esac

if ! [[ "$auto_reconnect" =~ ^[01]$ ]]; then
  echo "Invalid auto reconnect value: $auto_reconnect (expected 0 or 1)" >&2
  exit 1
fi

if ! [[ "$auto_reconnect_interval" =~ ^[0-9]+$ ]] || [[ "$auto_reconnect_interval" -lt 2 ]]; then
  echo "Invalid --auto-reconnect-interval value: $auto_reconnect_interval (expected integer >= 2)" >&2
  exit 1
fi

if [[ "$android_mode" -eq 1 ]]; then
  ensure_android_state_dir
fi

if [[ "$emulator_mode" -eq 1 && "$cmd" != "android-doctor" ]]; then
  require_emulator_access
fi

if [[ "$cmd" == "start" || "$cmd" == "shell" || "$cmd" == "warm" ]]; then
  ensure_vscode_url_handler
fi

if [[ "$cmd" != "logs" ]] && [[ "$logs_follow" -eq 1 ]]; then
  echo "-f/--follow is only valid with the logs command." >&2
  exit 1
fi

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  build-base)
    podman build -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
    exit 0
    ;;
  build)
    podman build -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
    exit 0
    ;;
  rebuild)
    echo "Rebuilding $IMAGE without removing existing containers..."
    podman build --no-cache -t "$IMAGE" -f "$BUILD_CONTEXT/Dockerfile" "$BUILD_CONTEXT"
    exit 0
    ;;
  logs)
    if [[ -n "${workspace:-}" && -d "$workspace" ]]; then
      workspace="$(realpath "$workspace")"
      target_container="$(pick_running_container_for_workspace "$workspace")"
      [[ -n "${target_container:-}" ]] || target_container="$(pick_running_container)"
    else
      target_container="$(pick_running_container)"
    fi

    [[ -n "${target_container:-}" ]] || { echo "No AI sandbox container found." >&2; exit 1; }
    if [[ "$logs_follow" -eq 1 ]]; then
      exec podman logs -f "$target_container"
    else
      exec podman logs "$target_container"
    fi
    ;;
  doctor-net)
    if [[ -n "${workspace:-}" && -d "$workspace" ]]; then
      workspace="$(realpath "$workspace")"
      target_container="$(pick_running_container_for_workspace "$workspace")"
      [[ -n "${target_container:-}" ]] || target_container="$(pick_running_container)"
    else
      target_container="$(pick_running_container)"
    fi

    [[ -n "${target_container:-}" ]] || { echo "No AI sandbox container found." >&2; exit 1; }
    container_mode="$(container_network_mode "$target_container")"
    host_default_route="$(ip route show default 2>/dev/null | head -n1 || true)"
    host_dns="$(awk '/^nameserver /{print $2}' /etc/resolv.conf 2>/dev/null | xargs || true)"
    container_dns="$(podman exec "$target_container" /bin/bash -lc "awk '/^nameserver /{print \$2}' /etc/resolv.conf | xargs" 2>/dev/null || true)"
    container_proxy="$(podman exec "$target_container" /bin/bash -lc "env | grep -Ei '^(http|https|no)_proxy='" 2>/dev/null || true)"

    dns_status="fail"
    ip_status="fail"
    if probe_container_dns "$target_container"; then dns_status="ok"; fi
    if probe_container_https_ip "$target_container"; then ip_status="ok"; fi

    echo "AI_SANDBOX_NET_DOCTOR: container=$target_container mode=$container_mode"
    echo "AI_SANDBOX_NET_DOCTOR: host_default_route=${host_default_route:-<none>}"
    echo "AI_SANDBOX_NET_DOCTOR: host_nameservers=${host_dns:-<none>}"
    echo "AI_SANDBOX_NET_DOCTOR: container_nameservers=${container_dns:-<none>}"
    echo "AI_SANDBOX_NET_DOCTOR: container_dns_probe=$dns_status container_ip_probe=$ip_status"
    if [[ -n "$container_proxy" ]]; then
      echo "AI_SANDBOX_NET_DOCTOR: container_proxy_env:"
      echo "$container_proxy"
    else
      echo "AI_SANDBOX_NET_DOCTOR: container_proxy_env=<none>"
    fi

    if [[ "$dns_status" == "ok" ]]; then
      echo "AI_SANDBOX_NET_DOCTOR: result=healthy"
      exit 0
    fi
    if [[ "$ip_status" == "ok" ]]; then
      echo "AI_SANDBOX_NET_DOCTOR: result=dns-broken (try: ai-sandbox reconnect-network ${workspace:-.})"
      exit 2
    fi
    echo "AI_SANDBOX_NET_DOCTOR: result=network-broken"
    exit 1
    ;;
  reconnect-network)
    if [[ -n "${workspace:-}" && -d "$workspace" ]]; then
      workspace="$(realpath "$workspace")"
      target_container="$(pick_running_container_for_workspace "$workspace")"
      [[ -n "${target_container:-}" ]] || target_container="$(pick_running_container)"
    else
      target_container="$(pick_running_container)"
    fi

    [[ -n "${target_container:-}" ]] || { echo "No AI sandbox container found." >&2; exit 1; }
    reconnect_container_network "$target_container" "manual"
    exit $?
    ;;
  reset-container)
    if [[ "$reset_all_containers" -eq 1 ]]; then
      mapfile -t sandbox_containers < <(podman ps -a --filter label=ai-sandbox=true --format '{{.Names}}')
    else
      workspace="$(realpath "$workspace")"
      mapfile -t sandbox_containers < <(podman ps -a --filter "label=ai-sandbox.workspace=$workspace" --format '{{.Names}}')
    fi

    if [[ ${#sandbox_containers[@]} -gt 0 ]]; then
      podman rm -f "${sandbox_containers[@]}" >/dev/null
      echo "Removed containers: ${sandbox_containers[*]}"
    else
      echo "No matching sandbox containers to remove."
    fi
    exit 0
    ;;
  reset-storage|reset-volumes)
    # Stop/remove running AI sandbox containers first so storage can be removed.
    mapfile -t sandbox_containers < <(podman ps -aq --filter label=ai-sandbox=true)
    if [[ ${#sandbox_containers[@]} -gt 0 ]]; then
      podman rm -f "${sandbox_containers[@]}" >/dev/null
    fi

    for storage in "$NIX_STORAGE" "$HOME_STORAGE" "$ANDROID_STATE_DIR"; do
      if [[ "$storage" == /* ]]; then
        case "$storage" in
          "/"|"")
            echo "Refusing to reset unsafe storage path: $storage" >&2
            exit 1
            ;;
        esac
        rm -rf -- "$storage"
        mkdir -p -- "$storage"
      else
        if podman volume exists "$storage"; then
          podman volume rm -f "$storage" >/dev/null
        fi
      fi
    done

    echo "Reset storage: $NIX_STORAGE, $HOME_STORAGE, $ANDROID_STATE_DIR"
    exit 0
    ;;
  repair-nix)
    selinux_label_opt="$(selinux_mount_label_opt)"
    home_mount_spec="$(storage_mount_spec "$HOME_STORAGE" /sandbox-home "$selinux_label_opt")"
    nix_mount_spec="$(storage_mount_spec "$NIX_STORAGE" /nix "$selinux_label_opt")"

    exec podman run --rm -it \
      --userns=keep-id \
      --user "$(id -u):$(id -g)" \
      --group-add keep-groups \
      --label ai-sandbox=true \
      -e HOME=/sandbox-home \
      -e XDG_RUNTIME_DIR=/tmp/xdg-runtime \
      -e AI_SANDBOX_MODE=repair \
      -v "$home_mount_spec" \
      -v "$nix_mount_spec" \
      "$IMAGE"
    ;;
  prune)
    run_prune
    exit $?
    ;;
  agents)
    [[ -n "$sync_mode" ]] || { echo "agents requires pull, push, reset, or clear" >&2; exit 1; }
    run_agents_sync "$sync_mode" "$sync_path_arg"
    exit 0
    ;;
  skills)
    [[ -n "$sync_mode" ]] || { echo "skills requires pull or push" >&2; exit 1; }
    run_skills_sync "$sync_mode" "$sync_path_arg"
    exit 0
    ;;
  open-url)
    [[ -n "$open_url_arg" ]] || { echo "open-url requires a URL" >&2; exit 1; }
    container="$(pick_running_container)"
    if [[ -n "$container" ]]; then
      exec podman exec "$container" /usr/local/bin/ai-sandbox-open-url "$open_url_arg"
    fi
    exec code --open-url "$open_url_arg"
    echo "No running AI sandbox container found, and host VS Code failed to handle --open-url." >&2
    exit 1
    ;;
  open-in-editor)
    [[ -n "$open_editor_file" ]] || { echo "open-in-editor requires FILE [LINE] [COLUMN]" >&2; exit 1; }
    if ! [[ -z "$open_editor_line" || "$open_editor_line" =~ ^[0-9]+$ ]]; then
      echo "LINE must be numeric: $open_editor_line" >&2
      exit 1
    fi
    if ! [[ -z "$open_editor_col" || "$open_editor_col" =~ ^[0-9]+$ ]]; then
      echo "COLUMN must be numeric: $open_editor_col" >&2
      exit 1
    fi

    target="$open_editor_file"
    if [[ -n "$open_editor_line" && -n "$open_editor_col" ]]; then
      target="${target}:${open_editor_line}:${open_editor_col}"
    elif [[ -n "$open_editor_line" ]]; then
      target="${target}:${open_editor_line}"
    fi

    container="$(pick_running_container_for_file "$open_editor_file" || true)"
    [[ -n "$container" ]] || container="$(pick_running_container)"
    if [[ -n "$container" ]]; then
      target="$(map_host_target_for_container "$container" "$target")"
      exec podman exec "$container" bash -lc '
        editor_bin="$(command -v code || true)"
        if [[ -z "$editor_bin" ]]; then
          echo "No VS Code binary found inside sandbox container." >&2
          exit 127
        fi

        exec "$editor_bin" \
          --user-data-dir "${AI_SANDBOX_VSCODE_USER_DATA_DIR:-/sandbox-home/.vscode-data}" \
          --extensions-dir "${AI_SANDBOX_VSCODE_EXTENSIONS_DIR:-/sandbox-home/.vscode-extensions}" \
          --goto "$1"
      ' _ "$target"
    fi

    exec code --goto "$target"
    ;;
esac

case "$cmd" in
  start|shell|warm|exec|install|repair-nix|android-doctor)
    ensure_image_exists
    ;;
  serve)
    [[ "$server_stop" -eq 1 ]] || ensure_image_exists
    ;;
  mcp)
    if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 &&
      "$mcp_sessions" -eq 0 && -z "$mcp_attach_id" &&
      "$mcp_show_token" -eq 0 && "$mcp_unslot" -eq 0 &&
      "$mcp_slots_mode" -eq 0 && "$mcp_gateway_mode" -eq 0 ]]; then
      ensure_image_exists
    fi
    ;;
esac

[[ -d "$workspace" ]] || { echo "Workspace does not exist: $workspace" >&2; exit 1; }
project_name="$(basename "$workspace")"
selinux_label_opt="$(selinux_mount_label_opt)"

home_mount_spec=""
nix_mount_spec=""
if [[ "$HOME_STORAGE" == /* ]]; then
  mkdir -p "$HOME_STORAGE"
  home_mount_spec="$HOME_STORAGE:/sandbox-home${selinux_label_opt}"
else
  home_mount_spec="$HOME_STORAGE:/sandbox-home${selinux_label_opt},U"
fi

if [[ "$NIX_STORAGE" == /* ]]; then
  mkdir -p "$NIX_STORAGE"
  nix_mount_spec="$NIX_STORAGE:/nix${selinux_label_opt}"
else
  nix_mount_spec="$NIX_STORAGE:/nix${selinux_label_opt},U"
fi

mount_root="$workspace"
container_workspace="/workspace"

# Preserve parent directory depth for submodule workspaces by mounting the top
# superproject root and opening the requested workspace path underneath it.
if command -v git >/dev/null 2>&1 && git -C "$workspace" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  probe="$workspace"
  while true; do
    superproject="$(git -C "$probe" rev-parse --show-superproject-working-tree 2>/dev/null || true)"
    [[ -n "$superproject" ]] || break
    probe="$(realpath "$superproject")"
  done

  if [[ "$probe" != "$workspace" ]]; then
    mount_root="$probe"
    workspace_rel="$(realpath --relative-to="$mount_root" "$workspace")"
    container_workspace="/workspace/$workspace_rel"
  fi
fi

workspace_hash="$(echo -n "$workspace" | sha256sum | cut -c1-12)"

if [[ "$cmd" == "mcp" ]]; then
  mcp_require_home_path
  if [[ "$mcp_gateway_mode" -eq 1 ]]; then
    mcp_gateway_dispatch \
      "$mcp_gateway_cmd" "$mcp_gateway_slots" \
      "$mcp_public_url" "$mcp_gateway_dev_insecure" "$mcp_json"
    exit $?
  fi
  if [[ "$mcp_slots_mode" -eq 1 ]]; then
    mcp_gateway_print_slots "$mcp_json"
    exit $?
  fi
  if [[ "$mcp_unslot" -eq 1 ]]; then
    mcp_gateway_unassign "$workspace_hash"
    exit $?
  fi
  if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 && "$mount_root" != "$workspace" ]]; then
    echo "ai-sandbox mcp cannot expose a submodule through an expanded parent mount." >&2
    echo "Run it from the top-level mounted repository instead: $mount_root" >&2
    exit 1
  fi
  if [[ "$mcp_status" -eq 0 && "$mcp_stop" -eq 0 && "$mcp_tunnel_selected" -eq 1 ]]; then
    if [[ -z "$mcp_tunnel_id" && -t 0 && -t 2 ]]; then
      # Interactive starts offer the tunnel picker once the workspace runtime
      # state is known; only the runtime key is collected eagerly.
      mcp_load_tunnel_credentials \
        "$workspace_hash" "" \
        mcp_tunnel_id mcp_runtime_api_key
      mcp_tunnel_prompt=1
    else
      mcp_resolve_tunnel_credentials \
        "$workspace_hash" \
        "$mcp_tunnel_id" \
        mcp_tunnel_id \
        mcp_runtime_api_key
    fi
  fi
fi

flake_arg_container="${flake_arg:-}"
if [[ -n "${flake_arg:-}" ]]; then
  if [[ "$flake_arg" == "$mount_root" || "$flake_arg" == "$mount_root/"* ]]; then
    flake_rel="$(realpath --relative-to="$mount_root" "$flake_arg")"
    if [[ "$flake_rel" == "." ]]; then
      flake_arg_container="/workspace"
    else
      flake_arg_container="/workspace/$flake_rel"
    fi
  fi
fi

if [[ "$cmd" == mcp &&
  ( "$mcp_show_token" -eq 1 || "$mcp_transport_count" -ne 0 ) ]]; then
  mcp_prepare_secret_dir "$workspace_hash"
  mcp_secret_lock="$(mcp_secret_workspace_dir "$workspace_hash")/.lock"
  [[ ! -L "$mcp_secret_lock" ]] || {
    echo "Refusing symlinked MCP credential lock." >&2
    exit 1
  }
  exec {mcp_secret_lock_fd}>"$mcp_secret_lock"
  chmod 0600 "$mcp_secret_lock"
  if ! flock -w 2 "$mcp_secret_lock_fd"; then
    echo "Another MCP credential operation is already in progress for this workspace." >&2
    exit 1
  fi
  mcp_resolve_connection_name "$workspace_hash" "$mcp_connection" mcp_connection


  if [[ "$mcp_show_token" -eq 1 ]]; then
    mcp_print_http_token "$workspace_hash"
    flock -u "$mcp_secret_lock_fd"
    exec {mcp_secret_lock_fd}>&-
    exit 0
  fi

  mcp_resolve_http_token "$workspace_hash" mcp_http_token
  if [[ "$mcp_publish" == cloudflare ]]; then
    mcp_resolve_cloudflare_named_config \
      "$workspace_hash" "$mcp_public_url" \
      mcp_cloudflare_token mcp_public_url
  fi
  flock -u "$mcp_secret_lock_fd"
  exec {mcp_secret_lock_fd}>&-
fi

project_slug="$(sanitize_container_name_part "$project_name" "workspace")"
launch_context="vscode"
if [[ "$cmd" == "shell" || "$cmd" == "warm" || "$cmd" == "exec" ]]; then
  launch_context="shell"
elif [[ "$cmd" == "serve" ]]; then
  launch_context="code-server"
elif [[ "$cmd" == "mcp" ]]; then
  launch_context="mcp"
elif [[ "$cmd" == "android-doctor" ]]; then
  launch_context="android-doctor"
fi

runtime_profile="default"
if [[ "$emulator_mode" -eq 1 ]]; then
  runtime_profile="emulator"
  [[ "$android_gpu" -eq 1 ]] && runtime_profile="emulator-gpu"
elif [[ "$android_mode" -eq 1 ]]; then
  runtime_profile="android"
fi

base_container_name="ai-sandbox-${project_slug}-${launch_context}-${workspace_hash}"
if [[ "$runtime_profile" != "default" ]]; then
  base_container_name="$base_container_name-$runtime_profile"
fi
if [[ -n "$instance_arg" ]]; then
  container_name="$base_container_name-$instance_arg"
else
  if [[ "$cmd" == "shell" ]]; then
    instance_arg="$(pick_auto_instance_name "$base_container_name")"
  else
    instance_arg="default"
  fi
  container_name="$base_container_name-$instance_arg"
fi

if [[ "$cmd" == "mcp" ]]; then
  mcp_metadata="$(mcp_runtime_host_dir "$workspace_hash")/runtime/metadata.json"
  mcp_recorded_container="$(mcp_read_metadata_field "$mcp_metadata" container)"
  mcp_recorded_reuse="$(mcp_read_metadata_field "$mcp_metadata" reuse_emulator)"
  mcp_recorded_profile="$(mcp_read_metadata_field "$mcp_metadata" profile)"
  mcp_recorded_share="$(mcp_read_metadata_field "$mcp_metadata" share_home)"
  if [[ "$mcp_recorded_share" == true ]]; then
    mcp_share_home=1
  elif [[ "$mcp_share_home" -eq 1 ]] &&
    [[ "$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)" == running ]]; then
    echo "MCP is already running with the isolated MCP home." >&2
    echo "Stop it before switching to --share-home." >&2
    exit 1
  fi
  if [[ "$mcp_android_selected" -eq 1 ]]; then
    if [[ -f "$mcp_metadata" && "$mcp_recorded_container" != "$container_name" ]]; then
      echo "MCP state for this workspace records a different container:" >&2
      printf '  recorded: %s\n' "${mcp_recorded_container:-<unknown>}" >&2
      printf '  requested: %s\n' "$container_name" >&2
      echo "Stop the recorded MCP and clear its state with:" >&2
      echo "  ais mcp --stop" >&2
      exit 1
    fi
  elif [[ "$mcp_recorded_reuse" == true ]]; then
    # Keep status and stop safe for MCP sessions started with the old reuse mode.
    if [[ "$network_selected" -eq 1 && "$NETWORK_MODE" != host ]]; then
      echo "MCP Android modes require host networking." >&2
      exit 1
    fi
    mcp_reuse_emulator=1
    container_name="$mcp_recorded_container"
  elif [[ "$mcp_recorded_profile" == android || "$mcp_recorded_profile" == emulator ||
    "$mcp_recorded_profile" == emulator-gpu ]]; then
    if [[ "$network_selected" -eq 1 && "$NETWORK_MODE" != host ]]; then
      echo "MCP Android modes require host networking." >&2
      exit 1
    fi
    android_mode=1
    [[ "$mcp_recorded_profile" == android ]] || emulator_mode=1
    [[ "$mcp_recorded_profile" != emulator-gpu ]] || android_gpu=1
    runtime_profile="$mcp_recorded_profile"
    NETWORK_MODE=host
    container_name="$mcp_recorded_container"
  fi
fi

if [[ "$cmd" == "serve" && "$server_stop" -eq 1 ]]; then
  if podman inspect "$container_name" >/dev/null 2>&1; then
    podman stop "$container_name" >/dev/null
    echo "Stopped code-server container $container_name."
  else
    echo "No code-server container found for $workspace (instance=$instance_arg)."
  fi
  exit 0
fi
if [[ "$cmd" == "mcp" && "$mcp_status" -eq 1 ]]; then
  mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
  exit 0
fi

if [[ "$cmd" == "mcp" && "$mcp_stop" -eq 1 ]]; then
  mcp_stop_rc=0
  mcp_stop_process "$container_name" "$workspace_hash" "$mcp_json" || mcp_stop_rc=$?
  if [[ "$mcp_json" -eq 1 ]]; then
    mcp_emit_status "$workspace" "$container_name" "$workspace_hash" 1
  fi
  exit "$mcp_stop_rc"
fi

if [[ "$cmd" == "mcp" && "$mcp_sessions" -eq 1 ]]; then
  if ! container_is_running "$container_name"; then
    echo "MCP container is not running." >&2
    exit 1
  fi
  podman exec "$container_name" \
    "/sandbox-home/.local/share/ai-sandbox/mcp/winx/$AI_SANDBOX_MCP_VERSION/winx-code-agent" list
  echo "Follow one with: ais mcp --attach THREAD_ID"
  exit 0
fi

if [[ "$cmd" == "mcp" && -n "$mcp_attach_id" ]]; then
  if ! container_is_running "$container_name"; then
    echo "MCP container is not running." >&2
    exit 1
  fi
  exec podman exec -it "$container_name" \
    "/sandbox-home/.local/share/ai-sandbox/mcp/winx/$AI_SANDBOX_MCP_VERSION/winx-code-agent" \
    attach "$mcp_attach_id" --follow
fi

code_server_port=""
if [[ "$cmd" == "serve" ]]; then
  code_server_port="$(resolve_code_server_port "$workspace_hash" "$instance_arg" "$container_name" "$server_port")"
fi
if [[ "$cmd" == mcp && "$mcp_local_selected" -eq 1 ]]; then
  mcp_host_port="$(resolve_mcp_port "$workspace_hash" "$container_name" "$mcp_port")"
fi

if [[ "$cmd" != "mcp" ]]; then
  echo "$container_name" > "$STATE_DIR/last-container"
fi

# Keep process/cache/webview data per instance to avoid Chromium profile
# collisions, while sharing user-level settings/extensions for a desktop-like
# experience across sandbox instances.
vscode_profile_id="${workspace_hash}-${instance_arg}"
vscode_user_data_dir="/sandbox-home/.vscode-data/instances/$vscode_profile_id"
vscode_extensions_dir="/sandbox-home/.vscode-extensions/shared"
vscode_shared_user_dir="/sandbox-home/.vscode-shared-user"
code_server_user_data_dir="/sandbox-home/.code-server-data/instances/$vscode_profile_id"
code_server_extensions_dir="/sandbox-home/.code-server-extensions/shared"

theme="$(detect_theme)"

host_dbus_args=()
x11_args=()
if [[ "$cmd" != "install" && "$cmd" != "serve" && "$cmd" != "mcp" && "$cmd" != "android-doctor" ]]; then
  xauth_file="${XAUTHORITY:-$HOME/.Xauthority}"
  if [[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]]; then
    x11_args+=(
      -e "DISPLAY=$DISPLAY"
      -v /tmp/.X11-unix:/tmp/.X11-unix:ro
    )

    if [[ -f "$xauth_file" ]]; then
      x11_args+=(
        -e XAUTHORITY=/tmp/.Xauthority
        -v "$xauth_file:/tmp/.Xauthority:ro"
      )
    else
      echo "Warning: Xauthority file not found ($xauth_file); continuing without Xauthority mount." >&2
    fi
  fi

  if [[ -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/bus" ]]; then
    host_dbus_args=(
      -e "AI_SANDBOX_HOST_DBUS_SESSION_BUS_ADDRESS=unix:path=/host-run-user-bus"
      -v "${XDG_RUNTIME_DIR}/bus:/host-run-user-bus:rw"
    )
  fi
fi

container_mode="$cmd"
[[ "$cmd" == "serve" ]] && container_mode="server"
[[ "$cmd" == "mcp" ]] && container_mode="idle"

mcp_mount_args=()
if [[ "$cmd" == "mcp" ]]; then
  mcp_runtime_host="$(mcp_runtime_host_dir "$workspace_hash")"
  mkdir -p "$mcp_runtime_host/runtime"
  chmod 0700 "$mcp_runtime_host"
  if [[ "$mcp_share_home" -eq 1 ]]; then
    home_mount_spec="$HOME_STORAGE:/sandbox-home${selinux_label_opt}"
    echo "MCP shares the sandbox home: the remote AI can read stored credentials and agent config." >&2
    echo "Isolate it again by restarting without --share-home." >&2
  else
    home_mount_spec="$mcp_runtime_host:/sandbox-home${selinux_label_opt}"
    if [[ "$mcp_reuse_emulator" -eq 0 && -f "$HOME_STORAGE/.codex/AGENTS.md" ]]; then
      mkdir -p "$mcp_runtime_host/.codex"
      if [[ ! -f "$mcp_runtime_host/.codex/AGENTS.md" ]]; then
        cp "$HOME_STORAGE/.codex/AGENTS.md" "$mcp_runtime_host/.codex/AGENTS.md"
      fi
      mcp_agents_mount_opts="ro"
      [[ -z "$selinux_label_opt" ]] || mcp_agents_mount_opts+=",Z"
      mcp_mount_args=(
        -v "$HOME_STORAGE/.codex/AGENTS.md:/sandbox-home/.codex/AGENTS.md:$mcp_agents_mount_opts"
      )
    fi
  fi
fi

tmp_host_dir="$(prepare_tmp_mount "$TMP_ROOT" "$container_name")"

android_args=()
emulator_device_args=()
if [[ "$android_mode" -eq 1 ]]; then
  android_args=(
    -e ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
    -e AI_SANDBOX_ANDROID_MODE=1
    -e ANDROID_USER_HOME=/android-state/user
    -e ANDROID_AVD_HOME=/android-state/avd
    -e ANDROID_EMULATOR_HOME=/android-state/emulator
    -v "$ANDROID_STATE_DIR:/android-state${selinux_label_opt}"
  )
fi

if [[ "$emulator_mode" -eq 1 ]]; then
  android_args+=(
    -e AI_SANDBOX_EMULATOR_MODE=1
  )
  if [[ "$cmd" != "android-doctor" || -e /dev/kvm ]]; then
    emulator_device_args+=(--device=/dev/kvm)
  fi
  if [[ "$android_gpu" -eq 1 && ( "$cmd" != "android-doctor" || -e /dev/dri ) ]]; then
    emulator_device_args+=(--device=/dev/dri)
  fi
fi

mcp_port_args=()
if [[ "$cmd" == mcp && "$mcp_local_selected" -eq 1 ]]; then
  mcp_port_args=(
    -p "127.0.0.1:$mcp_host_port:$AI_SANDBOX_MCP_HTTP_PORT"
  )
fi

common_args=(
  --name "$container_name"
  --init
  --userns=keep-id
  --user "$(id -u):$(id -g)"
  --group-add keep-groups
  --label ai-sandbox=true
  --label "ai-sandbox.workspace=$workspace"
  --label "ai-sandbox.workspace-hash=$workspace_hash"
  --label "ai-sandbox.instance=$instance_arg"
  --label "ai-sandbox.profile=$runtime_profile"
  -e HOME=/sandbox-home
  -e CODEX_HOME=/sandbox-home/.codex
  -e XDG_RUNTIME_DIR=/tmp/xdg-runtime
  -e "AI_SANDBOX_MODE=$container_mode"
  -e "AI_SANDBOX_FLAKE=$flake_arg_container"
  -e "AI_SANDBOX_WORKSPACE=$container_workspace"
  -e "AI_SANDBOX_HOST_MOUNT_ROOT=$mount_root"
  -e "AI_SANDBOX_CONTAINER_MOUNT_ROOT=/workspace"
  -e "AI_SANDBOX_PROJECT_NAME=$project_name"
  -e "AI_SANDBOX_INSTANCE_NAME=$instance_arg"
  -e "AI_SANDBOX_NETWORK_MODE=$NETWORK_MODE"
  -e "AI_SANDBOX_THEME=$theme"
  -e "AI_SANDBOX_VSCODE_USER_DATA_DIR=$vscode_user_data_dir"
  -e "AI_SANDBOX_VSCODE_EXTENSIONS_DIR=$vscode_extensions_dir"
  -e "AI_SANDBOX_VSCODE_SHARED_USER_DIR=$vscode_shared_user_dir"
  -e "AI_SANDBOX_CODE_SERVER_USER_DATA_DIR=$code_server_user_data_dir"
  -e "AI_SANDBOX_CODE_SERVER_EXTENSIONS_DIR=$code_server_extensions_dir"
  -e "AI_SANDBOX_CODE_SERVER_PORT=$code_server_port"
  -v "$mount_root:/workspace${selinux_label_opt}"
  -v "$home_mount_spec"
  -v "$nix_mount_spec"
  -v "$tmp_host_dir:/tmp${selinux_label_opt}"
  "${mcp_port_args[@]}"
  "${mcp_mount_args[@]}"
  "${android_args[@]}"
  "${emulator_device_args[@]}"
  "${x11_args[@]}"
)

network_args=()
if [[ "$NETWORK_MODE" == "host" ]]; then
  network_args=(--network host)
elif [[ "$cmd" == "mcp" ]]; then
  # Ask Podman for an isolated namespace explicitly. It resolves this to
  # bridge networking when rootful and its rootless backend otherwise.
  network_args=(--network private)
fi

run_android_doctor() {
  echo "Running Android diagnostics in a temporary sandbox..."
  exec podman run --rm -it \
    "${common_args[@]}" \
    "${network_args[@]}" \
    "${host_dbus_args[@]}" \
    "$IMAGE"
}

run_detached() {
  local mode existing_state
  existing_state="$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)"

  if [[ "$existing_state" == "running" ]]; then
    echo "Sandbox container already running: $container_name"
  elif [[ -n "$existing_state" ]]; then
    echo "Starting existing sandbox container $container_name..."
    podman start "$container_name" >/dev/null
  else
    echo "Starting sandbox container $container_name..."
    podman run -d \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE" >/dev/null
    echo "Started $container_name"
  fi

  mode="$(container_network_mode "$container_name")"
  if [[ "$auto_reconnect" == "1" ]]; then
    maybe_start_auto_reconnect_watcher "$container_name" "$mode" "$auto_reconnect_interval"
  else
    echo "Auto-reconnect watcher disabled."
  fi
  if [[ "$cmd" == "serve" ]]; then
    wait_for_code_server "$container_name" "$code_server_port"
  else
    follow_startup_logs_until_vscode "$container_name"
  fi
  if [[ "$follow_logs_on_start" -eq 1 ]]; then
    echo "Continuing to follow logs for $container_name (Ctrl-C to stop following; container keeps running)..."
    podman logs -f --tail 0 "$container_name"
  fi
}

run_interactive() {
  if [[ "$cmd" == "warm" ]]; then
    echo "Starting warmup container..."
    podman run --rm -it \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE"
  fi
}

run_shell() {
  echo "Starting fresh sandbox container $container_name..."
  if [[ ${#shell_command[@]} -gt 0 ]]; then
    exec podman run --rm -it \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE" "${shell_command[@]}"
  fi

  exec podman run --rm -it \
    "${common_args[@]}" \
    "${network_args[@]}" \
    "${host_dbus_args[@]}" \
    "$IMAGE"
}

run_exec() {
  local existing_container existing_workspace existing_state

  existing_container="$(pick_running_container_for_workspace "$workspace" "$runtime_profile" || true)"
  if [[ -n "$existing_container" ]]; then
    echo "Reusing running sandbox container $existing_container..."
    if [[ "$auto_reconnect" == "1" ]]; then
      reconnect_container_network "$existing_container" "pre-exec" || true
    fi
    existing_workspace="$(container_workspace_from_env "$existing_container")"
    echo "Running command in sandbox workspace $existing_workspace: ${exec_command[*]}"
    exec podman exec -it "$existing_container" /bin/bash -lc 'cd "$1"; shift; exec "$@"' _ "$existing_workspace" "${exec_command[@]}"
  fi

  existing_state="$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)"
  if [[ -n "$existing_state" && "$existing_state" != "running" ]]; then
    echo "Starting existing sandbox container $container_name for exec..."
    podman start "$container_name" >/dev/null
  elif [[ -z "$existing_state" ]]; then
    echo "No sandbox container found for workspace; creating persistent container..."
    podman run -d \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "${host_dbus_args[@]}" \
      "$IMAGE" >/dev/null
  fi

  echo "Running command: ${exec_command[*]}"
  exec podman exec -it "$container_name" /bin/bash -lc 'cd "$1"; shift; exec "$@"' _ "$container_workspace" "${exec_command[@]}"
}

mcp_network_mode_matches() {
  local expected="$1"
  local actual="$2"

  if [[ "$expected" == host ]]; then
    if [[ "$actual" == host ]]; then
      return 0
    fi
    return 1
  fi

  case "$actual" in
    bridge|private|pasta|pasta:*|slirp4netns|slirp4netns:*) return 0 ;;
    *) return 1 ;;
  esac
}

mcp_require_network_mode() {
  local container="$1"
  local workspace="$2"
  local expected="$3"
  local actual="$4"

  mcp_network_mode_matches "$expected" "$actual" && return 0
  if [[ "$expected" == host ]]; then
    echo "MCP needs host networking, but this container uses '$actual'." >&2
  else
    echo "MCP needs isolated networking (bridge or rootless pasta), but this container uses '$actual'." >&2
  fi
  echo "Podman fixes networking when it creates a container." >&2
  echo "Stop MCP and remove this container before retrying:" >&2
  printf '  ais mcp %q --stop\n' "$workspace" >&2
  printf '  podman rm %s\n' "$container" >&2
  echo "Then retry the same ais mcp command." >&2
  return 1
}

run_mcp() {
  local existing_state actual_network expected_network runtime_dir lock_file
  local existing_mode existing_version existing_transport existing_publisher
  local legacy_container recorded_id requested_transport requested_publisher
  local tunnel_json http_json publish_json allowed_host new_tunnel=0

  runtime_dir="$(mcp_runtime_host_dir "$workspace_hash")"
  lock_file="$runtime_dir/runtime/lock"
  mkdir -p "$(dirname "$lock_file")"
  exec 8>"$lock_file"
  if ! flock -w 2 8; then
    echo "Another MCP operation is already in progress for this workspace." >&2
    return 1
  fi

  requested_transport=openai-tunnel
  requested_publisher=""
  if [[ "$mcp_local_selected" -eq 1 ]]; then
    requested_transport=streamable-http
  elif [[ -n "$mcp_publish" ]]; then
    requested_transport=streamable-http
    requested_publisher="$mcp_publish"
  fi

  expected_network="$NETWORK_MODE"
  [[ "$mcp_reuse_emulator" -eq 0 ]] || expected_network=host
  if [[ "$NETWORK_MODE" == host && "$android_mode" -eq 0 ]]; then
    echo "MCP host networking is enabled; its Bash can reach host-local services." >&2
  fi

  legacy_container="ai-sandbox-${project_slug}-workspace-${workspace_hash}-default"
  existing_state="$(podman inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || true)"

  if [[ "$mcp_reuse_emulator" -eq 1 && "$existing_state" != running ]]; then
    echo "The emulator-enabled container is no longer running: $container_name" >&2
    return 1
  fi

  existing_transport="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" transport)"
  existing_publisher="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" publisher)"
  existing_mode="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" mode)"
  existing_version="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" version)"

  if [[ "$existing_state" == running && -n "$existing_transport" &&
    "$existing_transport" != "$requested_transport" ]]; then
    echo "MCP is already running with transport=$existing_transport." >&2
    echo "Stop it before changing transports." >&2
    return 1
  fi
  if [[ "$existing_state" == running && "$requested_transport" == streamable-http &&
    "$existing_publisher" != "$requested_publisher" ]]; then
    echo "MCP is already running with publisher=${existing_publisher:-local}." >&2
    echo "Stop it before changing publishers." >&2
    return 1
  fi
  if [[ "$existing_state" == running && -n "$existing_version" &&
    "$existing_version" != "$AI_SANDBOX_MCP_VERSION" ]]; then
    echo "MCP is running Winx $existing_version; stop it before upgrading." >&2
    return 1
  fi
  if [[ "$existing_state" == running && -n "$existing_mode" &&
    "$existing_mode" != "$mcp_mode" ]]; then
    echo "MCP is already running with mode=$existing_mode." >&2
    return 1
  fi

  if [[ "$requested_transport" == openai-tunnel && "$mcp_tunnel_prompt" -eq 1 ]]; then
    tunnel_json="$(mcp_tunnel_status_json \
      "$container_name" "$runtime_dir" \
      "$(mcp_runtime_container_dir "$workspace_hash" "$(mcp_home_nested_flag)")")"
    if [[ "$(jq -r '.process_running' <<<"$tunnel_json")" != true ]]; then
      mcp_prompt_tunnel_selection \
        "$workspace_hash" mcp_tunnel_id mcp_runtime_api_key || return 1
      mcp_tunnel_prompt=0
    fi
  fi

  if [[ -n "$mcp_slot" ]]; then
    local slot_owner slot_owner_workspace slot_answer slot_takeover="$mcp_takeover_slot"
    slot_owner="$(mcp_gateway_slot_owner "$mcp_slot")"
    if [[ -n "$slot_owner" && "$slot_owner" != "$workspace_hash" ]]; then
      slot_owner_workspace="$(mcp_gateway_slot_workspace "$mcp_slot")"
      if [[ "$slot_takeover" -eq 1 ]]; then
        :
      elif [[ -t 0 && -t 2 ]]; then
        read -r -p "Gateway slot $mcp_slot is assigned to ${slot_owner_workspace:-$slot_owner}. Take it over? [y/N]: " slot_answer
        [[ "$slot_answer" == y || "$slot_answer" == Y ]] || {
          echo "Slot assignment cancelled." >&2
          return 1
        }
        slot_takeover=1
      else
        echo "Gateway slot $mcp_slot is already assigned to ${slot_owner_workspace:-$slot_owner}." >&2
        echo "Reassign it explicitly with --takeover-slot." >&2
        return 1
      fi
    fi
    if ! mcp_gateway_assign \
      "$workspace_hash" "$workspace" "$mcp_connection" "$mcp_slot" "$slot_takeover"; then
      return 1
    fi
  fi

  if [[ "$requested_transport" == streamable-http && "$existing_state" == running ]]; then
    http_json="$(mcp_http_status_json \
      "$container_name" "$runtime_dir" \
      "$(mcp_runtime_container_dir "$workspace_hash" "$(mcp_home_nested_flag)")")"
    publish_json="$(mcp_cloudflare_status_json \
      "$container_name" "$runtime_dir" \
      "$(mcp_runtime_container_dir "$workspace_hash" "$(mcp_home_nested_flag)")")"
    if [[ "$(jq -r '.process_running' <<<"$http_json")" == true &&
      ( -z "$requested_publisher" || "$(jq -r '.process_running' <<<"$publish_json")" == true ) ]]; then
      echo "MCP HTTP server is already running for this workspace." >&2
      mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
      return 0
    fi
  fi

  if [[ -n "$existing_state" && "$existing_state" != running &&
    "$mcp_reuse_emulator" -eq 0 ]]; then
    podman rm "$container_name" >/dev/null
    existing_state=""
  fi

  if [[ "$mcp_reuse_emulator" -eq 1 ]]; then
    recorded_id="$(mcp_read_metadata_field "$runtime_dir/runtime/metadata.json" container_id)"
    if [[ -n "$recorded_id" && "$recorded_id" != "$(mcp_container_id "$container_name")" ]]; then
      echo "The reused container changed; stop MCP before reconnecting." >&2
      return 1
    fi
    echo "Reusing emulator-enabled sandbox container $container_name..." >&2
  elif [[ "$existing_state" == running ]]; then
    echo "Reusing sandbox workspace container $container_name..." >&2
  else
    echo "Creating sandbox workspace container $container_name..." >&2
    podman run -d \
      "${common_args[@]}" \
      "${network_args[@]}" \
      "$IMAGE" >/dev/null
  fi

  actual_network="$(podman inspect -f '{{.HostConfig.NetworkMode}}' "$container_name")"
  if ! mcp_require_network_mode \
    "$container_name" "$workspace" "$expected_network" "$actual_network"; then
    return 1
  fi

  if [[ "$requested_transport" == openai-tunnel ]]; then
    tunnel_json="$(mcp_tunnel_status_json \
      "$container_name" "$runtime_dir" \
      "$(mcp_runtime_container_dir "$workspace_hash" "$(mcp_home_nested_flag)")")"
    if [[ "$(jq -r '.process_running' <<<"$tunnel_json")" != true ]]; then
      new_tunnel=1
      trap 'trap - INT TERM HUP; mcp_stop_process "$container_name" "$workspace_hash" 1 || true; exit 130' INT
      trap 'trap - INT TERM HUP; mcp_stop_process "$container_name" "$workspace_hash" 1 || true; exit 143' TERM
      trap 'trap - INT TERM HUP; mcp_stop_process "$container_name" "$workspace_hash" 1 || true; exit 129' HUP
    fi
    if ! mcp_start_tunnel \
      "$container_name" "$workspace_hash" \
      "$mcp_tunnel_id" "$mcp_runtime_api_key" \
      "$legacy_container"; then
      trap - INT TERM HUP
      [[ "$new_tunnel" -eq 0 ]] ||
        mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
    mcp_write_metadata \
      "$runtime_dir/runtime/metadata.json" \
      "$(mcp_container_id "$container_name")" "$mcp_mode" \
      "$container_name" "$mcp_reuse_emulator" "$runtime_profile" \
      openai-tunnel "" "" "" "$mcp_share_home"
    if ! mcp_store_tunnel_credentials \
      "$workspace_hash" "$mcp_tunnel_id" "$mcp_runtime_api_key"; then
      trap - INT TERM HUP
      [[ "$new_tunnel" -eq 0 ]] ||
        mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
    mcp_runtime_api_key=""
    mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
    if [[ "$mcp_detach" -eq 0 ]]; then
      flock -u 8
      mcp_supervise_tunnel "$container_name" "$workspace_hash"
    fi
    trap - INT TERM HUP
    return
  fi

  if [[ "$mcp_local_selected" -eq 1 ]]; then
    if ! mcp_start_http \
      "$container_name" "$workspace_hash" "$mcp_http_token" \
      0.0.0.0 ""; then
      mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
    mcp_write_metadata \
      "$runtime_dir/runtime/metadata.json" \
      "$(mcp_container_id "$container_name")" "$mcp_mode" \
      "$container_name" 0 "$runtime_profile" streamable-http "" \
      "$mcp_host_port" "" "$mcp_share_home"
    mcp_http_token=""
    mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
    return
  fi

  if [[ "$mcp_publish" == cloudflare-quick ]]; then
    if ! mcp_start_cloudflare \
      "$container_name" "$workspace_hash" quick "" ""; then
      mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
    publish_json="$(mcp_cloudflare_status_json \
      "$container_name" "$runtime_dir" \
      "$(mcp_runtime_container_dir "$workspace_hash" 0)")"
    mcp_public_url="$(jq -r '.public_url // empty' <<<"$publish_json")"
    allowed_host="$(mcp_public_host "$mcp_public_url")"
    if ! mcp_start_http \
      "$container_name" "$workspace_hash" "$mcp_http_token" \
      127.0.0.1 "$allowed_host"; then
      mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
  else
    allowed_host="$(mcp_public_host "$mcp_public_url")"
    if ! mcp_start_http \
      "$container_name" "$workspace_hash" "$mcp_http_token" \
      127.0.0.1 "$allowed_host"; then
      mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
    if ! mcp_start_cloudflare \
      "$container_name" "$workspace_hash" named \
      "$mcp_public_url" "$mcp_cloudflare_token"; then
      mcp_stop_process "$container_name" "$workspace_hash" 1 || true
      return 1
    fi
  fi

  mcp_write_metadata \
    "$runtime_dir/runtime/metadata.json" \
    "$(mcp_container_id "$container_name")" "$mcp_mode" \
    "$container_name" 0 "$runtime_profile" streamable-http \
    "$mcp_publish" "" "$mcp_public_url" "$mcp_share_home"
  mcp_http_token=""
  mcp_cloudflare_token=""
  mcp_emit_status "$workspace" "$container_name" "$workspace_hash" "$mcp_json"
}

run_install() {
  local existing_container install_args=()
  local start_ts launch_ts run_start_ts run_end_ts
  local -a podman_cmd
  local podman_rc=0
  start_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"

  echo "[ai-sandbox][install][$start_ts] Starting install flow for workspace: $workspace"
  echo "[ai-sandbox][install][$start_ts] Image: $IMAGE | Network: $NETWORK_MODE"
  if [[ -n "$selinux_label_opt" ]]; then
    echo "[ai-sandbox][install][$start_ts] Mount labeling: enabled ($selinux_label_opt)"
  else
    echo "[ai-sandbox][install][$start_ts] Mount labeling: disabled (SELinux not enabled)"
  fi

  if [[ "$install_force" -eq 1 ]]; then
    install_args+=(--force)
  fi
  install_args+=(--only "$install_only")
  echo "[ai-sandbox][install][$start_ts] Install options: ${install_args[*]}"

  echo "[ai-sandbox][install][$start_ts] Checking for an already running sandbox container..."
  existing_container="$(pick_running_container_for_workspace "$workspace" || true)"
  if [[ -n "$existing_container" ]]; then
    echo "[ai-sandbox][install][$start_ts] Reusing running sandbox container: $existing_container"
    echo "[ai-sandbox][install][$start_ts] Executing install script inside existing container..."
    exec podman exec -it "$existing_container" /usr/local/bin/ai-sandbox-default-install "${install_args[@]}"
  fi

  launch_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  echo "[ai-sandbox][install][$launch_ts] No running sandbox found for workspace."
  echo "[ai-sandbox][install][$launch_ts] Starting temporary container for install..."
  echo "[ai-sandbox][install][$launch_ts] If this step is slow, storage or container startup is likely the bottleneck."
  echo "[ai-sandbox][install][$launch_ts] Podman store info:"
  podman info --format '[ai-sandbox][install] graphDriver={{.Store.GraphDriverName}} graphRoot={{.Store.GraphRoot}} runRoot={{.Store.RunRoot}}' 2>/dev/null || \
    echo "[ai-sandbox][install][$launch_ts] podman info unavailable"
  echo "[ai-sandbox][install][$launch_ts] Launching: podman run --rm -it ... /usr/local/bin/ai-sandbox-default-install ${install_args[*]}"

  podman_cmd=(podman)
  if [[ "${AI_SANDBOX_PODMAN_DEBUG:-0}" == "1" ]]; then
    echo "[ai-sandbox][install][$launch_ts] Podman debug mode enabled (AI_SANDBOX_PODMAN_DEBUG=1)."
    podman_cmd+=(--log-level=debug)
  fi

  run_start_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  echo "[ai-sandbox][install][$run_start_ts] Executing podman run now..."
  "${podman_cmd[@]}" run --rm -it \
    "${common_args[@]}" \
    "${network_args[@]}" \
    "${host_dbus_args[@]}" \
    -e AI_SANDBOX_MODE=exec \
    "$IMAGE" /usr/local/bin/ai-sandbox-default-install "${install_args[@]}" || podman_rc=$?
  run_end_ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  echo "[ai-sandbox][install][$run_end_ts] podman run exited with code: $podman_rc"
  return "$podman_rc"
}

case "$cmd" in
  start) run_detached ;;
  serve) run_detached ;;
  mcp) run_mcp ;;
  shell) run_shell ;;
  warm) run_interactive ;;
  exec) run_exec ;;
  android-doctor) run_android_doctor ;;
  install) run_install ;;
  *) usage >&2; exit 1 ;;
esac
